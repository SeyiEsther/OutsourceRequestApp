@model OutsourceRequestApp.ViewComponents.NavContextViewModel
@{
    var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";
}

<a class="tbtn @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>

<a class="tbtn @(action == "Index" && ctrl == "Outsource" ? "active" : "")"
   asp-controller="Outsource" asp-action="Index">All Requests</a>

<a class="tbtn @(action == "Create" ? "active" : "")"
   asp-controller="Outsource" asp-action="Create">New Request</a>

<a class="tbtn @(action == "MyRequests" ? "active" : "")"
   asp-controller="Outsource" asp-action="MyRequests">My Requests</a>

@if (Model.IsApprover)
{
    <a class="tbtn @(action == "MyApprovals" ? "active" : "")"
       asp-controller="Outsource" asp-action="MyApprovals">
        My Approvals
        @if (Model.PendingCount > 0)
        {
            <span class="chip-badge">@Model.PendingCount</span>
        }
    </a>
}

@if (Model.IsAdmin)
{
    <a class="tbtn @(ctrl == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">Admin</a>
}
