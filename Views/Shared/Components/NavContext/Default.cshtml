@model OutsourceRequestApp.ViewComponents.NavContextViewModel
@{
    var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";
}

<style>
    .nav-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 999px;
        background: var(--red);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
        font-family: var(--mono);
        margin-left: 5px;
        line-height: 1;
    }
</style>

@* Home — always visible *@
<a class="nav-link @(ctrl == "Home" ? "active" : "")"
   asp-controller="Home" asp-action="Index">Home</a>

@if (Model.IsApprover)
{
    @* Approvers: My Approvals first, with live pending count badge *@
    <a class="nav-link @(action == "MyApprovals" ? "active" : "")"
       asp-controller="Outsource" asp-action="MyApprovals"
       title="Items awaiting your @Model.ApproverLabel review">
        My Approvals
        @if (Model.PendingCount > 0)
        {
            <span class="nav-badge">@Model.PendingCount</span>
        }
    </a>
}

@* All Requests — everyone can browse *@
<a class="nav-link @(action == "Index" && ctrl == "Outsource" ? "active" : "")"
   asp-controller="Outsource" asp-action="Index">All Requests</a>

@if (!Model.IsApprover)
{
    @* Non-approvers: New Request is a primary action, show it prominently *@
    <a class="nav-link @(action == "Create" ? "active" : "")"
       asp-controller="Outsource" asp-action="Create">New Request</a>
}

@* My Requests — everyone (approvers also submit requests sometimes) *@
<a class="nav-link @(action == "MyRequests" ? "active" : "")"
   asp-controller="Outsource" asp-action="MyRequests">My Requests</a>

@if (Model.IsApprover)
{
    @* Approvers can still create requests — just lower priority *@
    <a class="nav-link @(action == "Create" ? "active" : "")"
       asp-controller="Outsource" asp-action="Create">New Request</a>
}

@if (Model.IsAdmin)
{
    <a class="nav-link @(ctrl == "Admin" ? "active" : "")"
       asp-controller="Admin" asp-action="Index">Admin</a>
}
