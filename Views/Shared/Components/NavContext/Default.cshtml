@model OutsourceRequestApp.ViewComponents.NavContextViewModel
@{
    var ctrl   = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString()     ?? "";
}

<style>
    .nav-section {
        font-size: 9px; text-transform: uppercase;
        letter-spacing: 0.1em; color: var(--text3);
        font-weight: 600; padding: 10px 8px 5px;
    }

    .nav-item {
        display: flex; align-items: center; gap: 10px;
        padding: 9px 10px; border-radius: 8px;
        font-size: 13px; font-weight: 500;
        color: var(--text2); text-decoration: none;
        transition: background 0.12s, color 0.12s;
        margin-bottom: 1px; position: relative;
    }

    .nav-item:hover {
        color: var(--text);
        background: rgba(255,255,255,0.05);
    }

    .nav-item.active {
        color: var(--text);
        background: var(--accent-dim);
    }

    .nav-item.active::before {
        content: '';
        position: absolute; left: 0; top: 22%; bottom: 22%;
        width: 3px; background: var(--accent);
        border-radius: 0 3px 3px 0;
    }

    .nav-ico {
        width: 16px; height: 16px;
        flex-shrink: 0; opacity: 0.6;
        fill: none; stroke: currentColor;
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        transition: opacity 0.12s;
    }

    .nav-item:hover .nav-ico,
    .nav-item.active .nav-ico { opacity: 1; }

    .nav-badge {
        margin-left: auto;
        min-width: 18px; height: 18px;
        background: var(--accent); border-radius: 999px;
        font-size: 10px; font-weight: 700; color: #fff;
        display: flex; align-items: center; justify-content: center;
        padding: 0 5px; font-family: var(--mono);
    }
</style>

<div class="nav-section">Menu</div>

<a class="nav-item @(ctrl == "Home" ? "active" : "")"
   asp-controller="Home" asp-action="Index">
    <svg class="nav-ico" viewBox="0 0 24 24">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    Home
</a>

@if (Model.IsApprover)
{
    <a class="nav-item @(action == "MyApprovals" ? "active" : "")"
       asp-controller="Outsource" asp-action="MyApprovals">
        <svg class="nav-ico" viewBox="0 0 24 24">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
        </svg>
        My Approvals
        @if (Model.PendingCount > 0)
        {
            <span class="nav-badge">@Model.PendingCount</span>
        }
    </a>
}

<div class="nav-section" style="margin-top:6px;">Requests</div>

<a class="nav-item @(action == "Index" && ctrl == "Outsource" ? "active" : "")"
   asp-controller="Outsource" asp-action="Index">
    <svg class="nav-ico" viewBox="0 0 24 24">
        <rect x="3" y="3" width="18" height="18" rx="2"/>
        <line x1="3" y1="9" x2="21" y2="9"/>
        <line x1="9" y1="21" x2="9" y2="9"/>
    </svg>
    All Requests
</a>

<a class="nav-item @(action == "Create" ? "active" : "")"
   asp-controller="Outsource" asp-action="Create">
    <svg class="nav-ico" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="16"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
    </svg>
    New Request
</a>

<a class="nav-item @(action == "MyRequests" ? "active" : "")"
   asp-controller="Outsource" asp-action="MyRequests">
    <svg class="nav-ico" viewBox="0 0 24 24">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
    </svg>
    My Requests
</a>

@if (Model.IsAdmin)
{
    <div class="nav-section" style="margin-top:6px;">System</div>
    <a class="nav-item @(ctrl == "Admin" ? "active" : "")"
       asp-controller="Admin" asp-action="Index">
        <svg class="nav-ico" viewBox="0 0 24 24">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Admin Panel
    </a>
}
