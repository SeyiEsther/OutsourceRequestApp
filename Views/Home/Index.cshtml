@using OutsourceRequestApp.Models
@{
    ViewData["Title"] = "Home";
    bool   isAdmin         = (bool)(ViewBag.IsAdmin        ?? false);
    bool   isApprover      = (bool)(ViewBag.IsApprover     ?? false);
    string approverLabel   = (string)(ViewBag.ApproverLabel ?? "");
    int    pendingCount    = (int)(ViewBag.PendingCount     ?? 0);
    int    myRequestsCount = (int)(ViewBag.MyRequestsCount  ?? 0);
    var    recentRequests  = ViewBag.RecentRequests as List<OutsourceRequest> ?? new List<OutsourceRequest>();
}

<style>
    .dash { max-width: 1040px; margin: 0 auto; padding: 44px 28px 60px; }

    /* Header action bar */
    .dash-head {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 16px; margin-bottom: 32px; flex-wrap: wrap;
    }
    h1.dash-title {
        font-size: 28px; font-weight: 700;
        letter-spacing: -0.03em; line-height: 1.12;
    }
    h1.dash-title em { font-style: normal; color: var(--text2); font-weight: 300; }

    .btn-create {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 9px 16px; border-radius: 10px;
        background: #f4f4f5; color: #18181b;
        font-size: 13px; font-weight: 500;
        text-decoration: none; white-space: nowrap;
        transition: background .15s; flex-shrink: 0;
    }
    .btn-create:hover { background: #e4e4e7; color: #18181b; }
    .btn-create svg { width: 15px; height: 15px; stroke: #18181b; stroke-width: 2.2; }

    .role-chip {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 5px 13px; border-radius: 999px;
        font-size: 12px; font-weight: 500; margin-top: 14px;
    }
    .role-chip-red  { background: var(--accent-dim); border: 1px solid rgba(99,102,241,0.25); color: #818cf8; }
    .role-chip-gold { background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.22); color: #fbbf24; }
    .chip-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

    /* Dashboard grid: recent requests + workflow stepper */
    .dash-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
    @@media (min-width: 1024px) {
        .dash-grid { grid-template-columns: 2fr 1fr; }
    }

    .panel {
        background: rgba(0,0,0,0.4);
        border: 1px solid var(--border2);
        border-radius: 14px; padding: 22px;
    }
    .panel-title {
        font-size: 13px; font-weight: 600; letter-spacing: -0.01em;
        margin-bottom: 16px;
    }

    /* Recent requests table */
    .rt { width: 100%; text-align: left; border-collapse: collapse; font-size: 13px; }
    .rt thead th {
        font-size: 11px; font-weight: 500; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--text3);
        padding: 0 10px 10px 0;
    }
    .rt tbody td {
        padding: 11px 10px 11px 0;
        border-bottom: 1px solid var(--border);
        color: var(--text);
    }
    .rt tbody tr:last-child td { border-bottom: none; }
    .rt .cell-id   { font-family: var(--mono); color: var(--text2); }
    .rt .cell-muted { color: var(--text2); font-size: 12px; }
    .rt-empty { padding: 28px 0; text-align: center; color: var(--text3); font-size: 13px; }

    /* Workflow stepper */
    .stepper { display: flex; flex-direction: column; }
    .step-node { display: flex; gap: 12px; position: relative; }
    .step-node:not(:last-child) { padding-bottom: 26px; }
    .step-node:not(:last-child)::before {
        content: ''; position: absolute; left: 11px; top: 26px; bottom: 0;
        width: 2px; background: var(--border2);
    }
    .step-dot {
        width: 23px; height: 23px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        z-index: 1;
    }
    .step-dot.done   { background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.3); }
    .step-dot.done svg { width: 11px; height: 11px; stroke: #4ade80; stroke-width: 3; }
    .step-dot.active { background: var(--accent-dim); border: 1px solid rgba(99,102,241,0.35); position: relative; }
    .step-dot.active::after {
        content: ''; position: absolute; inset: -4px; border-radius: 50%;
        border: 1px solid rgba(99,102,241,0.3);
        animation: step-pulse 1.8s ease-out infinite;
    }
    .step-dot.active .step-pip { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
    .step-dot.pending { background: rgba(255,255,255,0.03); border: 1px solid var(--border2); }
    .step-dot.pending .step-pip { width: 6px; height: 6px; border-radius: 50%; background: var(--text3); }
    @@keyframes step-pulse {
        0%   { transform: scale(0.9); opacity: 0.8; }
        100% { transform: scale(1.5); opacity: 0; }
    }
    .step-label { font-size: 13px; font-weight: 500; line-height: 1.3; padding-top: 2px; }
    .step-label.muted { color: var(--text2); font-weight: 400; }
    .step-sub { font-size: 11px; color: var(--text3); margin-top: 2px; }

    /* Cards */
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 14px; }

    .dc {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 26px 24px;
        text-decoration: none; color: var(--text);
        display: flex; flex-direction: column;
        position: relative; overflow: hidden;
        transition: border-color 0.2s, transform 0.18s;
    }
    .dc::after {
        content: ''; position: absolute;
        bottom: 0; left: 0; right: 0; height: 2px;
        background: var(--accent);
        transform: scaleX(0); transform-origin: left;
        transition: transform 0.22s ease;
    }
    .dc:hover { border-color: var(--border2); transform: translateY(-2px); color: var(--text); }
    .dc:hover::after { transform: scaleX(1); }

    .dc-hero {
        border-color: rgba(99,102,241,0.25);
        background: linear-gradient(140deg, var(--card) 0%, rgba(99,102,241,0.06) 100%);
    }
    .dc-admin {
        border-color: rgba(245,158,11,0.2);
        background: linear-gradient(140deg, var(--card) 0%, rgba(245,158,11,0.05) 100%);
    }
    .dc-static { cursor: default; }
    .dc-static:hover { transform: none; border-color: var(--border); }
    .dc-static::after { display: none; }

    .dc-ico {
        width: 38px; height: 38px; border-radius: 10px;
        background: var(--accent-dim);
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 20px; flex-shrink: 0;
    }
    .dc-ico svg { width: 18px; height: 18px; stroke: var(--accent); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .dc-ico.gold { background: rgba(245,158,11,0.1); }
    .dc-ico.gold svg { stroke: #fbbf24; }

    .dc-num {
        font-family: var(--mono); font-size: 38px; font-weight: 600;
        color: var(--accent); line-height: 1; margin-bottom: 4px;
    }
    .dc-num.dim { color: var(--text2); }
    .dc-num-label {
        font-size: 10px; color: var(--text2);
        text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 18px;
    }
    .dc-title { font-size: 14px; font-weight: 600; margin-bottom: 8px; }
    .dc-desc  { font-size: 13px; color: var(--text2); line-height: 1.65; flex: 1; margin-bottom: 20px; }
    .dc-cta   { font-size: 12px; font-weight: 600; color: var(--accent); }
    .dc-stat  { display: flex; align-items: baseline; gap: 5px; margin-bottom: 18px; }
    .dc-stat-n { font-family: var(--mono); font-size: 22px; font-weight: 600; }
    .dc-stat-l { font-size: 11px; color: var(--text2); }

    @@media (max-width: 768px) {
        h1.dash-title { font-size: 26px; }
        .cards { grid-template-columns: 1fr; }
    }
</style>

<div class="dash">

    <div class="dash-head">
        <div>
            <h1 class="dash-title">Outsource Request Portal</h1>
            @if (isApprover)
            {
                <div class="role-chip role-chip-red">
                    <span class="chip-dot"></span>
                    @approverLabel Approver
                    @if (pendingCount > 0) { <text>— <strong>@pendingCount</strong> awaiting review</text> }
                </div>
            }
            else if (isAdmin)
            {
                <div class="role-chip role-chip-gold">
                    <span class="chip-dot"></span>
                    Administrator
                </div>
            }
        </div>
        <a class="btn-create" asp-controller="Outsource" asp-action="Create">
            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Create New Request
        </a>
    </div>

    @if (isApprover)
    {
        <div class="cards">
            <a class="dc dc-hero" asp-controller="Outsource" asp-action="MyApprovals">
                <div class="dc-ico"><svg viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
                @if (pendingCount > 0)
                {
                    <div class="dc-num">@pendingCount</div>
                    <div class="dc-num-label">pending approval@(pendingCount != 1 ? "s" : "")</div>
                }
                else
                {
                    <div class="dc-num dim">0</div>
                    <div class="dc-num-label">pending approvals</div>
                }
                <div class="dc-title">My Approvals</div>
                <p class="dc-desc">Review requests queued for your <strong>@approverLabel</strong> sign-off. Approve, reject, or add comments.</p>
                <div class="dc-cta">Open queue →</div>
            </a>

            <a class="dc" asp-controller="Outsource" asp-action="Index">
                <div class="dc-ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg></div>
                <div class="dc-title">All Requests</div>
                <p class="dc-desc">Browse every outsource request with search, status filters, and CSV export.</p>
                <div class="dc-cta">View all →</div>
            </a>

            <a class="dc" asp-controller="Outsource" asp-action="Create">
                <div class="dc-ico"><svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></div>
                <div class="dc-title">New Request</div>
                <p class="dc-desc">Submit a sheet metal outsource request with live SAP part-number lookup.</p>
                <div class="dc-cta">Create →</div>
            </a>

            @if (isAdmin)
            {
                <a class="dc dc-admin" asp-controller="Admin" asp-action="Index">
                    <div class="dc-ico gold"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
                    <div class="dc-title">Admin Panel</div>
                    <p class="dc-desc">Manage approver roles, SMTP settings, and admin users.</p>
                    <div class="dc-cta" style="color:#fbbf24">Open admin →</div>
                </a>
            }
        </div>
    }
    else if (isAdmin)
    {
        <div class="cards">
            <a class="dc dc-admin" asp-controller="Admin" asp-action="Index">
                <div class="dc-ico gold"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
                <div class="dc-title">Admin Panel</div>
                <p class="dc-desc">Manage approver assignments, configure SMTP email settings, and control admin access.</p>
                <div class="dc-cta" style="color:#fbbf24">Open admin →</div>
            </a>
            <a class="dc" asp-controller="Outsource" asp-action="Index">
                <div class="dc-ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg></div>
                <div class="dc-title">All Requests</div>
                <p class="dc-desc">Browse, search, and export every outsource request across all statuses.</p>
                <div class="dc-cta">View all →</div>
            </a>
            <a class="dc" asp-controller="Outsource" asp-action="Create">
                <div class="dc-ico"><svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></div>
                <div class="dc-title">New Request</div>
                <p class="dc-desc">Submit a sheet metal outsource request with live SAP part-number lookup.</p>
                <div class="dc-cta">Create →</div>
            </a>
        </div>
    }
    else
    {
        <div class="dash-grid">
            <div class="panel">
                <div class="panel-title">Recent Requests</div>
                <table class="rt">
                    <thead>
                        <tr>
                            <th>Request ID</th>
                            <th>Part Number</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentRequests.Count == 0)
                        {
                            <tr><td colspan="4" class="rt-empty">No requests submitted yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in recentRequests)
                            {
                                <tr>
                                    <td class="cell-id">OSR-@(r.RequestId.ToString("000000"))</td>
                                    <td>@r.PartNumber</td>
                                    <td class="cell-muted">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @RequestStatus.BadgeClass(r.Status)">@RequestStatus.Label(r.Status)</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="panel">
                <div class="panel-title">Approval Stages</div>
                <div class="stepper">
                    <div class="step-node">
                        <div class="step-dot done"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                        <div>
                            <div class="step-label">Supply Chain Review</div>
                            <div class="step-sub">Stage 1</div>
                        </div>
                    </div>
                    <div class="step-node">
                        <div class="step-dot active"><span class="step-pip"></span></div>
                        <div>
                            <div class="step-label">Finance Director Sign-off</div>
                            <div class="step-sub">Stage 2</div>
                        </div>
                    </div>
                    <div class="step-node">
                        <div class="step-dot pending"><span class="step-pip"></span></div>
                        <div>
                            <div class="step-label muted">MD Approval</div>
                            <div class="step-sub">Stage 3</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
