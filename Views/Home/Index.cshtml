@using OutsourceRequestApp.Models
@{
    ViewData["Title"] = "Home";
    bool   isAdmin        = (bool)(ViewBag.IsAdmin        ?? false);
    bool   isApprover     = (bool)(ViewBag.IsApprover     ?? false);
    string approverLabel  = (string)(ViewBag.ApproverLabel ?? "");
    int    pendingCount   = (int)(ViewBag.PendingCount     ?? 0);
    int    mySubmitted    = (int)(ViewBag.MySubmitted ?? 0);
    int    myReview       = (int)(ViewBag.MyReview    ?? 0);
    int    myApproved     = (int)(ViewBag.MyApproved  ?? 0);
    int    myRejected     = (int)(ViewBag.MyRejected  ?? 0);
    var    recentRequests = ViewBag.RecentRequests as List<OutsourceRequest> ?? new List<OutsourceRequest>();
    var    queuePreview   = ViewBag.QueuePreview as List<OutsourceRequest> ?? new List<OutsourceRequest>();
}

<style>
    .home-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
    @@media (min-width: 1024px) { .home-grid { grid-template-columns: 2.2fr 1fr; } }

    .queue-hero {
        display: flex; align-items: baseline; gap: 18px;
        padding: 22px 24px; margin-bottom: 14px;
        background: linear-gradient(135deg, var(--accent-soft) 0%, var(--white) 100%);
        border: 1px solid var(--border); border-radius: 14px;
        box-shadow: 0 1px 3px rgba(15,17,23,.04);
    }
    .queue-hero-num { font-size: 48px; font-weight: 800; letter-spacing: -0.02em; color: var(--red); line-height: 1; }
    .queue-hero-label { font-size: 14px; color: var(--muted); line-height: 1.4; max-width: 320px; }
    .queue-hero-label strong { color: var(--ink); }

    .system-note { font-size: 13px; color: var(--muted); line-height: 1.6; padding: 4px 2px; }

    @@media (max-width: 768px) {
        .queue-hero { flex-direction: column; gap: 6px; }
        .queue-hero-num { font-size: 36px; }
    }
</style>

<div class="page">

    <div class="page-head">
        <div>
            <div class="page-title">Outsource Request Portal</div>
            <div class="page-sub">
                @(isApprover ? $"{approverLabel} Approver" : isAdmin ? "Administrator" : "Track and submit outsource requests")
            </div>
        </div>
        <a class="sbtn primary" asp-controller="Outsource" asp-action="Create">+ Create New Request</a>
    </div>

    @if (isApprover)
    {
        <div class="queue-hero">
            <div class="queue-hero-num">@pendingCount</div>
            <div class="queue-hero-label">request@(pendingCount != 1 ? "s" : "") waiting on <strong>your</strong> sign-off right now.</div>
        </div>

        <div class="card">
            <div class="card-head"><span class="card-title">Pending Queue</span></div>
            <div class="grid-wrap" style="box-shadow:none;border:none;border-radius:0;margin-bottom:0;">
                <table class="dash-table">
                    <thead><tr><th>Request ID</th><th>Part Number</th><th>Submitted By</th><th>Date</th><th></th></tr></thead>
                    <tbody>
                        @if (queuePreview.Count == 0)
                        {
                            <tr><td colspan="5" class="empty">Queue is clear — nothing waiting on you.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in queuePreview)
                            {
                                <tr onclick="location.href='@Url.Action("Track", "Outsource", new { id = r.RequestId })'">
                                    <td>OSR-@(r.RequestId.ToString("000000"))</td>
                                    <td>@r.PartNumber</td>
                                    <td style="color:var(--muted)">@r.CreatedByUsername</td>
                                    <td style="color:var(--muted)">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td><a class="dl-link" asp-controller="Outsource" asp-action="Track" asp-route-id="@r.RequestId">Review →</a></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <a class="sbtn sm" asp-controller="Outsource" asp-action="MyApprovals">Full approval queue</a>
            <a class="sbtn sm" asp-controller="Outsource" asp-action="Index">All requests</a>
            @if (isAdmin)
            {
                <a class="sbtn sm" asp-controller="Admin" asp-action="Index">Admin panel</a>
            }
        </div>
    }
    else if (isAdmin)
    {
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
            <a class="sbtn sm" asp-controller="Admin" asp-action="Index">Admin panel</a>
            <a class="sbtn sm" asp-controller="Outsource" asp-action="Index">All requests</a>
        </div>

        <div class="home-grid">
            <div class="card">
                <div class="card-head"><span class="card-title">Recent Requests</span></div>
                <div class="grid-wrap" style="box-shadow:none;border:none;border-radius:0;margin-bottom:0;">
                    <table class="dash-table">
                        <thead><tr><th>Request ID</th><th>Part Number</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @if (recentRequests.Count == 0)
                            {
                                <tr><td colspan="4" class="empty">No requests submitted yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var r in recentRequests)
                                {
                                    <tr onclick="location.href='@Url.Action("Track", "Outsource", new { id = r.RequestId })'">
                                        <td>OSR-@(r.RequestId.ToString("000000"))</td>
                                        <td>@r.PartNumber</td>
                                        <td style="color:var(--muted)">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td><span class="rag @RequestStatus.RagClass(r.Status)">@RequestStatus.Label(r.Status)</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card">
                <div class="card-head"><span class="card-title">System</span></div>
                <div class="card-body">
                    <div class="system-note">Manage approver assignments, SMTP settings, and admin access from the Admin panel.</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="kpi-row">
            <div class="kpi"><div class="kpi-label">Submitted</div><div class="kpi-val">@mySubmitted</div></div>
            <div class="kpi"><div class="kpi-label">In Review</div><div class="kpi-val amber">@myReview</div></div>
            <div class="kpi"><div class="kpi-label">Approved</div><div class="kpi-val green">@myApproved</div></div>
            <div class="kpi"><div class="kpi-label">Rejected</div><div class="kpi-val red">@myRejected</div></div>
        </div>

        <div class="home-grid">
            <div class="card">
                <div class="card-head"><span class="card-title">Recent Requests</span></div>
                <div class="grid-wrap" style="box-shadow:none;border:none;border-radius:0;margin-bottom:0;">
                    <table class="dash-table">
                        <thead><tr><th>Request ID</th><th>Part Number</th><th>Date</th><th>Status</th></tr></thead>
                        <tbody>
                            @if (recentRequests.Count == 0)
                            {
                                <tr><td colspan="4" class="empty">No requests submitted yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var r in recentRequests)
                                {
                                    <tr onclick="location.href='@Url.Action("Track", "Outsource", new { id = r.RequestId })'">
                                        <td>OSR-@(r.RequestId.ToString("000000"))</td>
                                        <td>@r.PartNumber</td>
                                        <td style="color:var(--muted)">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td><span class="rag @RequestStatus.RagClass(r.Status)">@RequestStatus.Label(r.Status)</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-body" style="display:flex;gap:10px;flex-wrap:wrap;padding-top:12px;">
                    <a class="sbtn sm" asp-controller="Outsource" asp-action="MyRequests">My requests</a>
                    <a class="sbtn sm" asp-controller="Outsource" asp-action="Index">All requests</a>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><span class="card-title">Approval Stages</span></div>
                <div class="card-body" style="display:flex;flex-direction:column;gap:14px;">
                    <div class="meta-item"><span class="meta-label">Stage 1</span><span class="meta-val">Work Preparation</span></div>
                    <div class="meta-item"><span class="meta-label">Stage 2</span><span class="meta-val">Production</span></div>
                    <div class="meta-item"><span class="meta-label">Stage 3</span><span class="meta-val">Cost Compact</span></div>
                    <div class="meta-item"><span class="meta-label">Stage 4</span><span class="meta-val">Sourcing &amp; Procurement</span></div>
                    <div class="meta-item"><span class="meta-label">Stage 5</span><span class="meta-val">MD Approval</span></div>
                </div>
            </div>
        </div>
    }

</div>
