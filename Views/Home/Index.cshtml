@{
    ViewData["Title"] = "Home";
}

<style>
    .home-wrap {
        max-width: 960px;
        margin: 0 auto;
        padding: 64px 28px 40px;
    }

    .home-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 18px;
    }

    .home-title {
        font-size: 38px;
        font-weight: 300;
        line-height: 1.18;
        color: var(--text);
        margin-bottom: 14px;
    }

        .home-title strong {
            font-weight: 600;
        }

    .home-sub {
        color: var(--muted);
        font-size: 15px;
        max-width: 500px;
        line-height: 1.7;
        margin-bottom: 52px;
    }

    .home-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
    }

    .home-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 30px 28px;
        text-decoration: none;
        color: var(--text);
        display: block;
        position: relative;
        overflow: hidden;
        transition: border-color 0.2s, transform 0.2s;
    }

        .home-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--red);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.25s ease;
        }

        .home-card:hover {
            border-color: var(--border2);
            transform: translateY(-3px);
            color: var(--text);
        }

            .home-card:hover::after {
                transform: scaleX(1);
            }

    .hc-icon {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        background: rgba(227, 6, 19, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
    }

        .hc-icon svg {
            width: 18px;
            height: 18px;
            stroke: var(--red);
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .hc-title {
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .hc-desc {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.65;
        margin-bottom: 22px;
    }

    .hc-arrow {
        font-size: 12px;
        font-weight: 500;
        color: var(--red);
    }
</style>

<div class="home-wrap">
    <div class="home-eyebrow">Sheet Metal Operations</div>
    <h1 class="home-title">Outsource<br><strong>Request Portal</strong></h1>
    <p class="home-sub">
        Digital workflow for managing sheet metal outsourcing requests across
        Work Prep, Supply Chain, Finance, and MD approval.
    </p>

    <div class="home-cards">

        <a class="home-card" asp-controller="Outsource" asp-action="Create">
            <div class="hc-icon">
                <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            </div>
            <div class="hc-title">New Request</div>
            <p class="hc-desc">Submit a new sheet metal outsource request with live SAP part number lookup.</p>
            <div class="hc-arrow">Create request →</div>
        </a>

        <a class="home-card" asp-controller="Outsource" asp-action="Index">
            <div class="hc-icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
            </div>
            <div class="hc-title">View Requests</div>
            <p class="hc-desc">Track and manage all submitted outsource requests and their current approval status.</p>
            <div class="hc-arrow">View all →</div>
        </a>

        <div class="home-card" style="cursor:default;">
            <div class="hc-icon">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            </div>
            <div class="hc-title">Approval Stages</div>
            <p class="hc-desc">Work Prep → Supply Chain → Finance Director → Managing Director. Track each stage in real time.</p>
            <div class="hc-arrow" style="color:var(--muted)">Four-stage workflow</div>
        </div>

    </div>
</div>
