@using OutsourceRequestApp.Models
@{
    ViewData["Title"] = "Home";
    bool   isAdmin        = (bool)(ViewBag.IsAdmin        ?? false);
    bool   isApprover     = (bool)(ViewBag.IsApprover     ?? false);
    string approverLabel  = (string)(ViewBag.ApproverLabel ?? "");
    int    pendingCount   = (int)(ViewBag.PendingCount     ?? 0);
    int    mySubmitted    = (int)(ViewBag.MySubmitted ?? 0);
    int    myReview       = (int)(ViewBag.MyReview    ?? 0);
    int    myApproved     = (int)(ViewBag.MyApproved  ?? 0);
    int    myRejected     = (int)(ViewBag.MyRejected  ?? 0);
    var    recentRequests = ViewBag.RecentRequests as List<OutsourceRequest> ?? new List<OutsourceRequest>();
    var    queuePreview   = ViewBag.QueuePreview as List<OutsourceRequest> ?? new List<OutsourceRequest>();
    string mode = isApprover ? "mode-approver" : isAdmin ? "mode-admin" : "mode-requester";
}

<style>
    .dash { max-width: 1100px; margin: 0 auto; padding: 44px 28px 60px; }

    /* Mode accent overrides — scoped to this page only */
    .mode-requester { --mode: var(--accent); --mode-d: var(--accent-d); --mode-dim: var(--accent-dim); --mode-text: #818cf8; }
    .mode-approver  { --mode: #2dd4bf; --mode-d: #14b8a6; --mode-dim: rgba(45,212,191,0.12); --mode-text: #2dd4bf; }
    .mode-admin     { --mode: #f59e0b; --mode-d: #d97706; --mode-dim: rgba(245,158,11,0.12); --mode-text: #fbbf24; }

    /* Header action bar */
    .dash-head {
        display: flex; align-items: flex-start; justify-content: space-between;
        gap: 16px; margin-bottom: 8px; flex-wrap: wrap;
    }
    h1.dash-title {
        font-size: 30px; font-weight: 800;
        letter-spacing: -0.035em; line-height: 1.1;
    }

    .btn-create {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 18px; border-radius: 10px;
        background: var(--mode); color: #07090d;
        font-size: 13px; font-weight: 600;
        text-decoration: none; white-space: nowrap;
        transition: background .15s, transform .12s; flex-shrink: 0;
    }
    .btn-create:hover { background: var(--mode-d); color: #07090d; transform: translateY(-1px); }
    .btn-create svg { width: 15px; height: 15px; stroke: #07090d; stroke-width: 2.4; }

    .mode-tag {
        display: inline-flex; align-items: center; gap: 7px;
        font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
        color: var(--mode-text); margin-bottom: 18px;
    }
    .mode-tag .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--mode); box-shadow: 0 0 0 3px var(--mode-dim); }

    /* ===================== Requester: bold stat row ===================== */
    .stat-row {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px;
        background: var(--border); border: 1px solid var(--border);
        border-radius: 14px; overflow: hidden; margin-bottom: 24px;
    }
    .stat-cell { background: rgba(0,0,0,0.4); padding: 20px 22px; }
    .stat-n {
        font-family: var(--mono); font-size: 34px; font-weight: 700;
        letter-spacing: -0.02em; line-height: 1;
    }
    .stat-n.c-sub { color: var(--mode-text); }
    .stat-n.c-rev { color: #fbbf24; }
    .stat-n.c-app { color: #4ade80; }
    .stat-n.c-rej { color: #f87171; }
    .stat-l {
        font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--text3); margin-top: 8px;
    }

    .dash-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
    @@media (min-width: 1024px) { .dash-grid { grid-template-columns: 2.2fr 1fr; } }

    .panel { background: rgba(0,0,0,0.4); border: 1px solid var(--border2); border-radius: 14px; padding: 22px; }
    .panel-title { font-size: 13px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 16px; }

    .rt { width: 100%; text-align: left; border-collapse: collapse; font-size: 13px; }
    .rt thead th {
        font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
        text-transform: uppercase; color: var(--text3);
        padding: 0 10px 10px 0;
    }
    .rt tbody td { padding: 11px 10px 11px 0; border-bottom: 1px solid var(--border); color: var(--text); }
    .rt tbody tr:last-child td { border-bottom: none; }
    .rt .cell-id    { font-family: var(--mono); color: var(--text2); }
    .rt .cell-muted { color: var(--text2); font-size: 12px; }
    .rt-empty { padding: 28px 0; text-align: center; color: var(--text3); font-size: 13px; }
    .rt-link  { color: var(--mode-text); font-weight: 600; font-size: 12px; text-decoration: none; }
    .rt-link:hover { color: var(--mode); }

    /* Stepper */
    .stepper { display: flex; flex-direction: column; }
    .step-node { display: flex; gap: 12px; position: relative; }
    .step-node:not(:last-child) { padding-bottom: 26px; }
    .step-node:not(:last-child)::before {
        content: ''; position: absolute; left: 11px; top: 26px; bottom: 0;
        width: 2px; background: var(--border2);
    }
    .step-dot { width: 23px; height: 23px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; z-index: 1; }
    .step-dot.done   { background: rgba(34,197,94,0.12); border: 1px solid rgba(34,197,94,0.3); }
    .step-dot.done svg { width: 11px; height: 11px; stroke: #4ade80; stroke-width: 3; }
    .step-dot.active { background: var(--mode-dim); border: 1px solid var(--mode); position: relative; }
    .step-dot.active::after {
        content: ''; position: absolute; inset: -4px; border-radius: 50%;
        border: 1px solid var(--mode);
        animation: step-pulse 1.8s ease-out infinite;
    }
    .step-dot.active .step-pip { width: 7px; height: 7px; border-radius: 50%; background: var(--mode); }
    .step-dot.pending { background: rgba(255,255,255,0.03); border: 1px solid var(--border2); }
    .step-dot.pending .step-pip { width: 6px; height: 6px; border-radius: 50%; background: var(--text3); }
    @@keyframes step-pulse { 0% { transform: scale(0.9); opacity: 0.8; } 100% { transform: scale(1.5); opacity: 0; } }
    .step-label { font-size: 13px; font-weight: 600; line-height: 1.3; padding-top: 2px; }
    .step-label.muted { color: var(--text2); font-weight: 400; }
    .step-sub { font-size: 11px; color: var(--text3); margin-top: 2px; }

    /* ===================== Approver: queue-first hero ===================== */
    .queue-hero {
        display: flex; align-items: baseline; gap: 18px;
        padding: 28px 26px; margin-bottom: 20px;
        background: linear-gradient(135deg, rgba(45,212,191,0.08) 0%, rgba(0,0,0,0.3) 100%);
        border: 1px solid var(--mode-dim); border-radius: 16px;
    }
    .queue-hero-num {
        font-family: var(--mono); font-size: 56px; font-weight: 800;
        letter-spacing: -0.03em; color: var(--mode); line-height: 1;
    }
    .queue-hero-label { font-size: 14px; color: var(--text2); line-height: 1.4; max-width: 320px; }
    .queue-hero-label strong { color: var(--text); }

    .qrow { transition: background .12s; }
    .qrow:hover { background: rgba(255,255,255,0.02); }
    .qrow td:first-child { border-radius: 6px 0 0 6px; }

    .pill-link {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 5px 12px; border-radius: 999px;
        background: var(--mode-dim); border: 1px solid var(--mode);
        color: var(--mode-text); font-size: 11px; font-weight: 600;
        text-decoration: none;
    }
    .pill-link:hover { background: var(--mode); color: #07090d; }

    .quick-links { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
    .quick-link {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 8px 14px; border-radius: 9px;
        border: 1px solid var(--border2); color: var(--text2);
        font-size: 12px; font-weight: 500; text-decoration: none;
        transition: all .15s;
    }
    .quick-link:hover { color: var(--text); border-color: var(--mode); background: var(--mode-dim); }

    @@media (max-width: 768px) {
        h1.dash-title { font-size: 24px; }
        .stat-row { grid-template-columns: repeat(2, 1fr); }
        .queue-hero { flex-direction: column; gap: 6px; }
        .queue-hero-num { font-size: 44px; }
    }
</style>

<div class="dash @mode">

    <div class="dash-head">
        <div>
            <h1 class="dash-title">Outsource Request Portal</h1>
        </div>
        <a class="btn-create" asp-controller="Outsource" asp-action="Create">
            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Create New Request
        </a>
    </div>

    @if (isApprover)
    {
        <div class="mode-tag"><span class="dot"></span>@approverLabel Approver</div>

        <div class="queue-hero">
            <div class="queue-hero-num">@pendingCount</div>
            <div class="queue-hero-label">request@(pendingCount != 1 ? "s" : "") waiting on <strong>your</strong> sign-off right now.</div>
        </div>

        <div class="panel">
            <div class="panel-title">Pending Queue</div>
            <table class="rt">
                <thead>
                    <tr><th>Request ID</th><th>Part Number</th><th>Submitted By</th><th>Date</th><th></th></tr>
                </thead>
                <tbody>
                    @if (queuePreview.Count == 0)
                    {
                        <tr><td colspan="5" class="rt-empty">Queue is clear — nothing waiting on you.</td></tr>
                    }
                    else
                    {
                        @foreach (var r in queuePreview)
                        {
                            <tr class="qrow">
                                <td class="cell-id">OSR-@(r.RequestId.ToString("000000"))</td>
                                <td>@r.PartNumber</td>
                                <td class="cell-muted">@r.CreatedByUsername</td>
                                <td class="cell-muted">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td><a class="pill-link" asp-controller="Outsource" asp-action="Track" asp-route-id="@r.RequestId">Review →</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="quick-links">
            <a class="quick-link" asp-controller="Outsource" asp-action="MyApprovals">Full approval queue</a>
            <a class="quick-link" asp-controller="Outsource" asp-action="Index">All requests</a>
            @if (isAdmin)
            {
                <a class="quick-link" asp-controller="Admin" asp-action="Index">Admin panel</a>
            }
        </div>
    }
    else if (isAdmin)
    {
        <div class="mode-tag"><span class="dot"></span>Administrator</div>

        <div class="quick-links" style="margin-top:0;">
            <a class="quick-link" asp-controller="Admin" asp-action="Index">Admin panel</a>
            <a class="quick-link" asp-controller="Outsource" asp-action="Index">All requests</a>
        </div>

        <div class="dash-grid" style="margin-top:20px;">
            <div class="panel">
                <div class="panel-title">Recent Requests</div>
                <table class="rt">
                    <thead><tr><th>Request ID</th><th>Part Number</th><th>Date</th><th>Status</th></tr></thead>
                    <tbody>
                        @if (recentRequests.Count == 0)
                        {
                            <tr><td colspan="4" class="rt-empty">No requests submitted yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in recentRequests)
                            {
                                <tr>
                                    <td class="cell-id">OSR-@(r.RequestId.ToString("000000"))</td>
                                    <td>@r.PartNumber</td>
                                    <td class="cell-muted">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @RequestStatus.BadgeClass(r.Status)">@RequestStatus.Label(r.Status)</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="panel">
                <div class="panel-title">System</div>
                <div class="step-sub" style="font-size:13px;color:var(--text2);">Manage approver assignments, SMTP settings, and admin access from the Admin panel.</div>
            </div>
        </div>
    }
    else
    {
        <div class="stat-row">
            <div class="stat-cell"><div class="stat-n c-sub">@mySubmitted</div><div class="stat-l">Submitted</div></div>
            <div class="stat-cell"><div class="stat-n c-rev">@myReview</div><div class="stat-l">In Review</div></div>
            <div class="stat-cell"><div class="stat-n c-app">@myApproved</div><div class="stat-l">Approved</div></div>
            <div class="stat-cell"><div class="stat-n c-rej">@myRejected</div><div class="stat-l">Rejected</div></div>
        </div>

        <div class="dash-grid">
            <div class="panel">
                <div class="panel-title">Recent Requests</div>
                <table class="rt">
                    <thead>
                        <tr><th>Request ID</th><th>Part Number</th><th>Date</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @if (recentRequests.Count == 0)
                        {
                            <tr><td colspan="4" class="rt-empty">No requests submitted yet.</td></tr>
                        }
                        else
                        {
                            @foreach (var r in recentRequests)
                            {
                                <tr>
                                    <td class="cell-id">OSR-@(r.RequestId.ToString("000000"))</td>
                                    <td>@r.PartNumber</td>
                                    <td class="cell-muted">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @RequestStatus.BadgeClass(r.Status)">@RequestStatus.Label(r.Status)</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                <div class="quick-links">
                    <a class="quick-link" asp-controller="Outsource" asp-action="MyRequests">My requests</a>
                    <a class="quick-link" asp-controller="Outsource" asp-action="Index">All requests</a>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title">Approval Stages</div>
                <div class="stepper">
                    <div class="step-node">
                        <div class="step-dot done"><svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
                        <div><div class="step-label">Supply Chain Review</div><div class="step-sub">Stage 1</div></div>
                    </div>
                    <div class="step-node">
                        <div class="step-dot active"><span class="step-pip"></span></div>
                        <div><div class="step-label">Finance Director Sign-off</div><div class="step-sub">Stage 2</div></div>
                    </div>
                    <div class="step-node">
                        <div class="step-dot pending"><span class="step-pip"></span></div>
                        <div><div class="step-label muted">MD Approval</div><div class="step-sub">Stage 3</div></div>
                    </div>
                </div>
            </div>
        </div>
    }

</div>
