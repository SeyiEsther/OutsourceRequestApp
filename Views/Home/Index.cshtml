@{
    ViewData["Title"] = "Home";

    bool   isAdmin         = (bool)(ViewBag.IsAdmin        ?? false);
    bool   isApprover      = (bool)(ViewBag.IsApprover     ?? false);
    string approverLabel   = (string)(ViewBag.ApproverLabel ?? "");
    int    pendingCount    = (int)(ViewBag.PendingCount     ?? 0);
    int    myRequestsCount = (int)(ViewBag.MyRequestsCount  ?? 0);
}

<style>
    .home-wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 60px 28px 60px;
    }

    .home-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: 16px;
    }

    .home-title {
        font-size: 36px;
        font-weight: 300;
        line-height: 1.18;
        color: var(--text);
        margin-bottom: 12px;
    }

        .home-title strong { font-weight: 600; }

    .home-sub {
        color: var(--muted);
        font-size: 14px;
        max-width: 480px;
        line-height: 1.7;
        margin-bottom: 48px;
    }

    /* Role chip shown below the subtitle */
    .role-banner {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 500;
        margin-bottom: 48px;
    }

    .role-banner-approver {
        background: rgba(227,6,19,0.1);
        border: 1px solid rgba(227,6,19,0.3);
        color: #ff6b74;
    }

    .role-banner-admin {
        background: rgba(251,191,36,0.1);
        border: 1px solid rgba(251,191,36,0.25);
        color: #fbbf24;
    }

    .role-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    /* Cards grid */
    .home-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 14px;
    }

    .home-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 28px 26px;
        text-decoration: none;
        color: var(--text);
        display: block;
        position: relative;
        overflow: hidden;
        transition: border-color 0.2s, transform 0.2s;
    }

        .home-card::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 2px;
            background: var(--red);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.25s ease;
        }

        .home-card:hover {
            border-color: var(--border2);
            transform: translateY(-3px);
            color: var(--text);
        }

        .home-card:hover::after { transform: scaleX(1); }

    /* Primary hero card (approver / admin emphasis) */
    .home-card.card-hero {
        border-color: rgba(227,6,19,0.3);
        background: linear-gradient(135deg, var(--surface) 0%, rgba(227,6,19,0.04) 100%);
    }

        .home-card.card-hero::after { background: var(--red); }

    .home-card.card-static {
        cursor: default;
    }

        .home-card.card-static:hover {
            transform: none;
            border-color: var(--border);
        }

        .home-card.card-static::after { display: none; }

    .hc-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: rgba(227,6,19,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 18px;
        flex-shrink: 0;
    }

        .hc-icon svg {
            width: 17px;
            height: 17px;
            stroke: var(--red);
            fill: none;
            stroke-width: 1.6;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .hc-icon.admin-icon { background: rgba(251,191,36,0.1); }
        .hc-icon.admin-icon svg { stroke: #fbbf24; }

    .hc-title {
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Big pending count inside the card */
    .hc-count {
        font-family: var(--mono);
        font-size: 32px;
        font-weight: 400;
        color: var(--red);
        margin-bottom: 4px;
        line-height: 1;
    }

    .hc-count-label {
        font-size: 11px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 18px;
    }

    .hc-desc {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.65;
        margin-bottom: 20px;
    }

    .hc-arrow {
        font-size: 12px;
        font-weight: 500;
        color: var(--red);
    }

    /* Stat line inside card */
    .hc-stat {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--muted);
        margin-bottom: 18px;
    }

    .hc-stat-num {
        font-size: 18px;
        color: var(--text);
    }

    @@media (max-width: 768px) {
        .home-cards { grid-template-columns: 1fr; }
        .home-title { font-size: 28px; }
    }
</style>

<div class="home-wrap">

    <div class="home-eyebrow">Sheet Metal Operations</div>
    <h1 class="home-title">Outsource<br><strong>Request Portal</strong></h1>
    <p class="home-sub">
        Digital workflow for managing sheet metal outsourcing requests across
        Supply Chain, Finance, and MD approval stages.
    </p>

    @* ── Role banner ─────────────────────────────────────────────────── *@
    @if (isApprover)
    {
        <div class="role-banner role-banner-approver">
            <span class="role-dot"></span>
            Signed in as <strong>@approverLabel Approver</strong>
            @if (pendingCount > 0)
            {
                <span>— <strong>@pendingCount</strong> item@(pendingCount != 1 ? "s" : "") awaiting your review</span>
            }
        </div>
    }
    else if (isAdmin)
    {
        <div class="role-banner role-banner-admin">
            <span class="role-dot"></span>
            Signed in as <strong>Administrator</strong>
        </div>
    }

    @* ══════════════════════════════════════════════════════════════════
       APPROVER home page
    ══════════════════════════════════════════════════════════════════ *@
    @if (isApprover)
    {
        <div class="home-cards">

            @* Primary: My Approvals with live count *@
            <a class="home-card card-hero" asp-controller="Outsource" asp-action="MyApprovals">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><polyline points="9 11 12 14 22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                </div>
                @if (pendingCount > 0)
                {
                    <div class="hc-count">@pendingCount</div>
                    <div class="hc-count-label">pending approval@(pendingCount != 1 ? "s" : "")</div>
                }
                else
                {
                    <div class="hc-count" style="color:var(--muted);">0</div>
                    <div class="hc-count-label">pending approvals</div>
                }
                <div class="hc-title">My Approvals</div>
                <p class="hc-desc">
                    Review requests queued for your <strong>@approverLabel</strong> sign-off.
                    Click through to approve, reject, or add comments.
                </p>
                <div class="hc-arrow">Open queue →</div>
            </a>

            @* All Requests *@
            <a class="home-card" asp-controller="Outsource" asp-action="Index">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                </div>
                <div class="hc-title">All Requests</div>
                <p class="hc-desc">Browse every outsource request with search, status filters, and CSV export.</p>
                <div class="hc-arrow">View all →</div>
            </a>

            @* New Request — de-emphasised for approvers *@
            <a class="home-card" asp-controller="Outsource" asp-action="Create">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                </div>
                <div class="hc-title">New Request</div>
                <p class="hc-desc">Submit a sheet metal outsource request with live SAP part-number lookup.</p>
                <div class="hc-arrow">Create request →</div>
            </a>

            @if (isAdmin)
            {
                <a class="home-card" asp-controller="Admin" asp-action="Index">
                    <div class="hc-icon admin-icon">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M20 21a8 8 0 1 0-16 0" /><polyline points="16 11 17.5 14 21 14 18.5 16.5 19.5 20 16 18 12.5 20 13.5 16.5 11 14 14.5 14" /></svg>
                    </div>
                    <div class="hc-title">Admin Panel</div>
                    <p class="hc-desc">Manage approver roles, SMTP settings, admin users, and send test emails.</p>
                    <div class="hc-arrow" style="color:#fbbf24">Open admin →</div>
                </a>
            }

        </div>
    }

    @* ══════════════════════════════════════════════════════════════════
       ADMIN-ONLY (not an approver) home page
    ══════════════════════════════════════════════════════════════════ *@
    else if (isAdmin)
    {
        <div class="home-cards">

            <a class="home-card card-hero" asp-controller="Admin" asp-action="Index">
                <div class="hc-icon admin-icon">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M20 21a8 8 0 1 0-16 0" /><polyline points="16 11 17.5 14 21 14 18.5 16.5 19.5 20 16 18 12.5 20 13.5 16.5 11 14 14.5 14" /></svg>
                </div>
                <div class="hc-title">Admin Panel</div>
                <p class="hc-desc">Manage approver assignments, configure SMTP email settings, and control who has admin access.</p>
                <div class="hc-arrow" style="color:#fbbf24">Open admin →</div>
            </a>

            <a class="home-card" asp-controller="Outsource" asp-action="Index">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                </div>
                <div class="hc-title">All Requests</div>
                <p class="hc-desc">Browse, search, and export every outsource request across all statuses.</p>
                <div class="hc-arrow">View all →</div>
            </a>

            <a class="home-card" asp-controller="Outsource" asp-action="Create">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                </div>
                <div class="hc-title">New Request</div>
                <p class="hc-desc">Submit a sheet metal outsource request with live SAP part-number lookup.</p>
                <div class="hc-arrow">Create request →</div>
            </a>

        </div>
    }

    @* ══════════════════════════════════════════════════════════════════
       REGULAR USER home page
    ══════════════════════════════════════════════════════════════════ *@
    else
    {
        <div class="home-cards">

            <a class="home-card card-hero" asp-controller="Outsource" asp-action="Create">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                </div>
                <div class="hc-title">New Request</div>
                <p class="hc-desc">
                    Submit a sheet metal outsource request. Fill in the part number for live SAP lookup,
                    add cost breakdown and justification, and attach supporting documents.
                </p>
                <div class="hc-arrow">Create request →</div>
            </a>

            <a class="home-card" asp-controller="Outsource" asp-action="MyRequests">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                </div>
                @if (myRequestsCount > 0)
                {
                    <div class="hc-stat">
                        <span class="hc-stat-num">@myRequestsCount</span>
                        <span>of my request@(myRequestsCount != 1 ? "s" : "")</span>
                    </div>
                }
                <div class="hc-title">My Requests</div>
                <p class="hc-desc">Track the status of requests you've submitted, withdraw pending ones, or print sign-off sheets.</p>
                <div class="hc-arrow">View mine →</div>
            </a>

            <a class="home-card" asp-controller="Outsource" asp-action="Index">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="3" y1="9" x2="21" y2="9" /><line x1="9" y1="21" x2="9" y2="9" /></svg>
                </div>
                <div class="hc-title">All Requests</div>
                <p class="hc-desc">Browse every outsource request across all statuses with search, filter, and CSV export.</p>
                <div class="hc-arrow">View all →</div>
            </a>

            <div class="home-card card-static">
                <div class="hc-icon">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                </div>
                <div class="hc-title">Approval Workflow</div>
                <p class="hc-desc">
                    Once submitted your request moves through four stages:
                    <br /><br />
                    <strong>Supply Chain</strong> → <strong>Finance Director</strong> → <strong>Managing Director</strong>
                    <br /><br />
                    You'll receive an email at each decision point.
                </p>
                <div class="hc-arrow" style="color:var(--muted)">Four-stage workflow</div>
            </div>

        </div>
    }

</div>
