@model OutsourceRequestApp.Models.OutsourceRequest
@inject OutsourceRequestApp.Services.AccessControlService Access

@{
    ViewData["Title"] = "New Outsource Request";
}

<style>
    /* Steps indicator */
    .form-steps { display: flex; gap: 0; margin-bottom: 24px; }
    .step-pill {
        flex: 1; display: flex; align-items: center; gap: 8px;
        padding: 10px 16px;
        background: var(--white); border: 1px solid var(--border);
        font-size: 12px; color: var(--muted); font-weight: 500;
    }
    .step-pill:first-child { border-radius: 9px 0 0 9px; }
    .step-pill:last-child  { border-radius: 0 9px 9px 0; }
    .step-pill + .step-pill { border-left: none; }
    .step-pill.active { background: var(--accent-soft); border-color: #c7d2fe; color: var(--accent); }
    .step-num {
        width: 20px; height: 20px; border-radius: 50%;
        background: var(--surface); color: var(--muted);
        display: flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 700; flex-shrink: 0;
    }
    .step-pill.active .step-num { background: var(--accent); color: #fff; }

    /* Validation */
    .val-summary {
        background: var(--red-bg); border: 1px solid #fca5a5;
        border-radius: 9px; padding: 14px 16px;
        margin-bottom: 22px; font-size: 13px; color: var(--red-text);
    }
    .val-summary ul { margin-left: 16px; margin-top: 6px; }
    .val-summary li { margin-bottom: 3px; }
    .field-error { font-size: 11px; color: var(--red-text); margin-top: 3px; }

    /* Part lookup */
    .part-wrap { position: relative; }
    .suggestions {
        position: absolute; top: calc(100% + 4px); left: 0; right: 0;
        background: var(--white); border: 1px solid var(--border);
        border-radius: 9px; z-index: 50; overflow: hidden;
        display: none; max-height: 220px; overflow-y: auto;
        box-shadow: var(--shadow-md);
    }
    .suggestions li {
        list-style: none; padding: 9px 13px; cursor: pointer;
        display: flex; justify-content: space-between; align-items: center;
        gap: 12px; font-size: 13px; transition: background var(--dur-fast);
    }
    .suggestions li:hover { background: var(--surface); }
    .sug-num  { font-size: 12px; font-weight: 600; color: var(--ink); flex-shrink: 0; }
    .sug-desc { font-size: 12px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .sap-spin {
        position: absolute; right: 10px; top: 50%;
        transform: translateY(-50%);
        width: 14px; height: 14px;
        border: 2px solid var(--border); border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin360 0.6s linear infinite;
        display: none; pointer-events: none;
    }
    #PartNumber { padding-right: 34px; }

    .char-count { font-size: 11px; color: var(--muted); text-align: right; margin-top: 4px; }

    /* File upload zone */
    .file-zone {
        border: 2px dashed var(--border); border-radius: 9px;
        padding: 28px 20px; text-align: center; cursor: pointer;
        transition: border-color var(--dur-fast), background var(--dur-fast);
        position: relative;
    }
    .file-zone:hover, .file-zone.drag-over {
        border-color: var(--accent); background: var(--accent-soft);
    }
    .file-zone input[type=file] {
        position: absolute; inset: 0; opacity: 0;
        cursor: pointer; width: 100%; height: 100%;
    }
    .fz-ico { color: var(--muted); margin-bottom: 8px; display: flex; justify-content: center; }
    .fz-label { font-size: 13px; color: var(--muted); margin-bottom: 4px; }
    .fz-label strong { color: var(--ink); }
    .fz-hint { font-size: 11px; color: var(--muted); }
    .fz-name { font-size: 12px; color: var(--accent); margin-top: 8px; min-height: 16px; font-weight: 600; }

    .submit-row { display: flex; justify-content: space-between; align-items: center; margin-top: 24px; }
</style>

<div class="wrap">

    <div class="page-head">
        <div>
            <div class="page-title">New Outsource Request</div>
            <div class="page-sub">Submit your request below. It then moves through Work Preparation, Production, Cost Compact, Sourcing and MD approval.</div>
        </div>
    </div>

    <div class="form-steps">
        <div class="step-pill active"><span class="step-num">1</span>Work Preparation</div>
        <div class="step-pill"><span class="step-num">2</span>Production</div>
        <div class="step-pill"><span class="step-num">3</span>Cost Compact</div>
        <div class="step-pill"><span class="step-num">4</span>Sourcing</div>
        <div class="step-pill"><span class="step-num">5</span>MD Approval</div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="val-summary">
            <strong>Please fix the following errors:</strong>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="section-label">Part details</div>
        <div class="card"><div class="card-body">
            <div class="form-grid">

                <div class="fl">
                    <label>Created by</label>
                    <input value="@Access.CurrentDisplayNameOrRaw" disabled />
                </div>

                <div class="fl">
                    <label>Drawing number</label>
                    <input asp-for="DrawingNumber" placeholder="e.g. DRW-00412" />
                </div>

                <div class="fl">
                    <label>Part number *</label>
                    <div class="part-wrap">
                        <input id="PartNumber" asp-for="PartNumber"
                               placeholder="Search SAP part number…" autocomplete="off" />
                        <div class="sap-spin" id="sapSpinner"></div>
                        <ul id="suggestions" class="suggestions"></ul>
                    </div>
                    <span asp-validation-for="PartNumber" class="field-error"></span>
                </div>

                <div class="fl">
                    <label>SAP description</label>
                    <input id="partDescription" asp-for="SapDescription"
                           placeholder="Auto-filled from SAP" readonly />
                </div>

                <div class="fl">
                    <label>Quantity *</label>
                    <input asp-for="Quantity" type="number" min="1" placeholder="0" />
                    <span asp-validation-for="Quantity" class="field-error"></span>
                </div>

                <div class="fl">
                    <label>Start date</label>
                    <input asp-for="StartDate" type="date" />
                </div>

                <div class="fl">
                    <label>End date</label>
                    <input asp-for="EndDate" type="date" />
                </div>

            </div>
        </div></div>

        <div class="section-label">Reason for request</div>
        <div class="card"><div class="card-body">
            <div class="fl">
                <label>Why can't this be produced in-house? *</label>
                <textarea id="reasonText" asp-for="Reason"
                          placeholder="Include capacity constraints, machine availability, skill gaps, or any other relevant details…"
                          maxlength="1000"></textarea>
                <div class="char-count"><span id="charCount">0</span> / 1000</div>
                <span asp-validation-for="Reason" class="field-error"></span>
            </div>
        </div></div>

        <div class="section-label">Attachments</div>
        <div class="card"><div class="card-body">
            <label style="font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:10px;">
                Supporting image or document (optional)
            </label>
            <div class="file-zone" id="fileZone">
                <input type="file" name="imageUpload" id="fileInput" accept="image/*,.pdf" />
                <div class="fz-ico">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <div class="fz-label"><strong>Click to upload</strong> or drag and drop</div>
                <div class="fz-hint">JPEG, PNG, GIF, BMP, WebP, PDF · Max 10 MB</div>
                <div class="fz-name" id="fileZoneName"></div>
            </div>
            <div id="imagePreview" style="margin-top:12px;"></div>
        </div></div>

        <div class="submit-row">
            <a class="sbtn" asp-controller="Home" asp-action="Index">Cancel</a>
            <button type="submit" class="sbtn primary">Submit Request →</button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        const partInput  = document.getElementById('PartNumber');
        const descInput  = document.getElementById('partDescription');
        const suggBox    = document.getElementById('suggestions');
        const sapSpinner = document.getElementById('sapSpinner');
        const reasonTA   = document.getElementById('reasonText');
        const charCount  = document.getElementById('charCount');

        let validPartSelected = false;
        let selectingSuggestion = false;

        reasonTA.addEventListener('input', () => { charCount.textContent = reasonTA.value.length; });
        charCount.textContent = reasonTA.value.length;

        async function searchParts(term) {
            sapSpinner.style.display = 'block';
            try {
                const res = await fetch(`/Outsource/SearchPart?term=${encodeURIComponent(term)}`);
                return await res.json();
            } catch { return []; }
            finally { sapSpinner.style.display = 'none'; }
        }

        partInput.addEventListener('input', async () => {
            validPartSelected = false;
            descInput.value = ''; descInput.style.color = '';
            const term = partInput.value.trim();
            if (term.length < 2) { suggBox.style.display = 'none'; return; }
            const data = await searchParts(term);
            suggBox.innerHTML = '';
            data.forEach(p => {
                const li = document.createElement('li');
                li.innerHTML = `<span class="sug-num">${p.partNumber}</span><span class="sug-desc">${p.description}</span>`;
                li.addEventListener('mousedown', e => {
                    e.preventDefault(); selectingSuggestion = true;
                    partInput.value = p.partNumber;
                    descInput.value = p.description; descInput.style.color = '';
                    validPartSelected = true; suggBox.style.display = 'none';
                    setTimeout(() => selectingSuggestion = false, 0);
                });
                suggBox.appendChild(li);
            });
            suggBox.style.display = data.length ? 'block' : 'none';
        });

        partInput.addEventListener('blur', async () => {
            if (selectingSuggestion || validPartSelected) return;
            suggBox.style.display = 'none';
            const value = partInput.value.trim();
            if (!value) return;
            const data = await searchParts(value);
            const match = data.find(p => p.partNumber.toLowerCase() === value.toLowerCase());
            if (match) {
                descInput.value = match.description; descInput.style.color = '';
                validPartSelected = true;
            } else {
                descInput.value = 'Part not found in SAP';
                descInput.style.color = 'var(--red-text)';
                validPartSelected = false;
            }
        });

        document.addEventListener('click', e => {
            if (!e.target.closest('.part-wrap')) suggBox.style.display = 'none';
        });

        document.querySelector('form').addEventListener('submit', e => {
            if (!validPartSelected) {
                e.preventDefault();
                SiteModal.alert(
                    'Please select a valid SAP part number from the dropdown suggestions before submitting.',
                    'Invalid Part Number'
                );
            }
        });

        // File upload zone
        const fileZone     = document.getElementById('fileZone');
        const fileInput    = document.getElementById('fileInput');
        const fileZoneName = document.getElementById('fileZoneName');
        const preview      = document.getElementById('imagePreview');

        fileZone.addEventListener('dragover',  e => { e.preventDefault(); fileZone.classList.add('drag-over'); });
        fileZone.addEventListener('dragleave', () => fileZone.classList.remove('drag-over'));
        fileZone.addEventListener('drop', e => {
            e.preventDefault(); fileZone.classList.remove('drag-over');
            if (e.dataTransfer.files.length) {
                const dt = new DataTransfer();
                dt.items.add(e.dataTransfer.files[0]);
                fileInput.files = dt.files;
                handleFile(fileInput.files[0]);
            }
        });
        fileInput.addEventListener('change', function () { handleFile(this.files[0]); });

        function handleFile(file) {
            preview.innerHTML = '';
            if (!file) { fileZoneName.textContent = ''; return; }
            fileZoneName.textContent = file.name;
            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = e => {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.cssText = 'max-width:220px;border-radius:8px;border:1px solid var(--border);margin-top:8px;';
                    preview.appendChild(img);
                };
                reader.readAsDataURL(file);
            } else if (file.type === 'application/pdf') {
                preview.innerHTML = `<div style="font-size:12px;color:var(--muted);margin-top:6px;">📄 ${file.name} (PDF)</div>`;
            }
        }
    </script>
}
