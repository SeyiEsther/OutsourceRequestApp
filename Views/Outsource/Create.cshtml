@model OutsourceRequestApp.Models.OutsourceRequest

@{
    ViewData["Title"] = "New Outsource Request";
}

<style>
    .form-wrap {
        max-width: 860px;
        margin: 0 auto;
        padding: 44px 28px 60px;
    }

    .form-header {
        margin-bottom: 32px;
    }

        .form-header h2 {
            font-size: 22px;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .form-header p {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.6;
        }

    .part-wrap {
        position: relative;
    }

    .suggestions {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        right: 0;
        background: var(--surface2);
        border: 1px solid var(--border2);
        border-radius: 8px;
        z-index: 50;
        overflow: hidden;
        display: none;
        max-height: 220px;
        overflow-y: auto;
    }

        .suggestions li {
            list-style: none;
            padding: 9px 12px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            font-size: 13px;
            transition: background 0.12s;
        }

            .suggestions li:hover {
                background: rgba(227, 6, 19, 0.1);
            }

    .sug-num {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--text);
        flex-shrink: 0;
    }

    .sug-desc {
        font-size: 12px;
        color: var(--muted);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .char-count {
        font-size: 11px;
        color: var(--muted);
        text-align: right;
        margin-top: 4px;
    }

    .submit-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 28px;
    }

    .validation-summary {
        background: rgba(239,68,68,0.08);
        border: 1px solid rgba(239,68,68,0.25);
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 20px;
        font-size: 13px;
        color: #f87171;
    }

        .validation-summary ul {
            margin-left: 16px;
            margin-top: 6px;
        }

        .validation-summary li {
            margin-bottom: 3px;
        }

    .field-error {
        font-size: 11px;
        color: #f87171;
        margin-top: 3px;
    }

    .field input.input-error,
    .field textarea.input-error {
        border-color: rgba(239,68,68,0.5);
    }

    /* SAP lookup spinner */
    .sap-spinner {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        width: 14px;
        height: 14px;
        border: 2px solid var(--border);
        border-top-color: var(--red);
        border-radius: 50%;
        animation: sap-spin 0.6s linear infinite;
        display: none;
        pointer-events: none;
    }

    @@keyframes sap-spin { to { transform: translateY(-50%) rotate(360deg); } }

    #partNumber { padding-right: 32px; }

    /* Styled file upload zone */
    .file-zone {
        border: 2px dashed var(--border2);
        border-radius: 8px;
        padding: 24px 20px;
        text-align: center;
        cursor: pointer;
        transition: border-color .15s, background .15s;
        position: relative;
    }

    .file-zone:hover, .file-zone.drag-over {
        border-color: var(--red);
        background: rgba(227,6,19,.04);
    }

    .file-zone input[type=file] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .file-zone-icon {
        color: var(--muted);
        margin-bottom: 8px;
        display: flex;
        justify-content: center;
    }

    .file-zone-label {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 4px;
    }

        .file-zone-label strong { color: var(--text); }

    .file-zone-hint {
        font-size: 11px;
        color: var(--muted);
        opacity: 0.7;
    }

    .file-zone-name {
        font-size: 12px;
        color: var(--red);
        margin-top: 8px;
        font-family: var(--mono);
        min-height: 16px;
    }
</style>

<div class="form-wrap">

    <div class="form-header">
        <h2>New Outsource Request</h2>
        <p>Section 1 — Work Preparation. Supply Chain &amp; Finance complete Section 2 after submission.</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            <strong>Please fix the following errors:</strong>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="section-label">Part details</div>
        <div class="form-card">
            <div class="form-grid">

                <div class="field">
                    <label>Created by</label>
                    <input value="@User.Identity?.Name" disabled />
                </div>

                <div class="field">
                    <label>Drawing number</label>
                    <input asp-for="DrawingNumber" placeholder="e.g. DRW-00412" />
                </div>

                <div class="field">
                    <label>Part number *</label>
                    <div class="part-wrap">
                        <input id="partNumber"
                               asp-for="PartNumber"
                               placeholder="Search SAP part number…"
                               autocomplete="off" />
                        <div class="sap-spinner" id="sapSpinner"></div>
                        <ul id="suggestions" class="suggestions"></ul>
                    </div>
                    <span asp-validation-for="PartNumber" class="field-error"></span>
                </div>

                <div class="field">
                    <label>SAP description</label>
                    <input id="partDescription"
                           asp-for="SapDescription"
                           placeholder="Auto-filled from SAP"
                           readonly />
                </div>

                <div class="field">
                    <label>Quantity *</label>
                    <input asp-for="Quantity" type="number" min="1" placeholder="0" />
                    <span asp-validation-for="Quantity" class="field-error"></span>
                </div>

                <div class="field">
                    <label>Start date</label>
                    <input asp-for="StartDate" type="date" />
                </div>

                <div class="field">
                    <label>End date</label>
                    <input asp-for="EndDate" type="date" />
                </div>

            </div>
        </div>

        <div class="section-label">Reason for request</div>
        <div class="form-card">
            <div class="field">
                <label>Why can't this be produced in-house? *</label>
                <textarea id="reasonText"
                          asp-for="Reason"
                          placeholder="Include capacity constraints, machine availability, skill gaps, or any other relevant details…"
                          maxlength="1000"></textarea>
                <div class="char-count"><span id="charCount">0</span> / 1000</div>
                <span asp-validation-for="Reason" class="field-error"></span>
            </div>
        </div>

        <div class="section-label">Attachments</div>
        <div class="form-card">
            <label style="font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:8px;">
                Supporting image or document (optional)
            </label>
            <div class="file-zone" id="fileZone">
                <input type="file" name="imageUpload" id="fileInput" accept="image/*,.pdf" />
                <div class="file-zone-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                </div>
                <div class="file-zone-label"><strong>Click to upload</strong> or drag and drop</div>
                <div class="file-zone-hint">JPEG, PNG, GIF, BMP, WebP, PDF · Max 10 MB</div>
                <div class="file-zone-name" id="fileZoneName"></div>
            </div>
            <div id="imagePreview" style="margin-top:12px;"></div>
        </div>

        <div class="submit-row">
            <a class="btn-ghost" asp-controller="Home" asp-action="Index">Cancel</a>
            <button type="submit" class="btn-primary">Submit Request →</button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        const partInput = document.getElementById('partNumber');
        const descInput = document.getElementById('partDescription');
        const suggBox   = document.getElementById('suggestions');
        const sapSpinner = document.getElementById('sapSpinner');
        const reasonTA  = document.getElementById('reasonText');
        const charCount = document.getElementById('charCount');

        let validPartSelected = false;
        let selectingSuggestion = false;

        // Character counter
        reasonTA.addEventListener('input', () => { charCount.textContent = reasonTA.value.length; });
        charCount.textContent = reasonTA.value.length;

        // SAP part lookup with loading indicator
        async function searchParts(term) {
            sapSpinner.style.display = 'block';
            try {
                const res = await fetch(`/Outsource/SearchPart?term=${encodeURIComponent(term)}`);
                return await res.json();
            } catch {
                return [];
            } finally {
                sapSpinner.style.display = 'none';
            }
        }

        partInput.addEventListener('input', async () => {
            validPartSelected = false;
            descInput.value = '';
            descInput.style.color = '';

            const term = partInput.value.trim();
            if (term.length < 2) { suggBox.style.display = 'none'; return; }

            const data = await searchParts(term);
            suggBox.innerHTML = '';

            data.forEach(p => {
                const li = document.createElement('li');
                li.innerHTML = `<span class="sug-num">${p.partNumber}</span><span class="sug-desc">${p.description}</span>`;
                li.addEventListener('mousedown', e => {
                    e.preventDefault();
                    selectingSuggestion = true;
                    partInput.value   = p.partNumber;
                    descInput.value   = p.description;
                    descInput.style.color = '';
                    validPartSelected = true;
                    suggBox.style.display = 'none';
                    setTimeout(() => selectingSuggestion = false, 0);
                });
                suggBox.appendChild(li);
            });

            suggBox.style.display = data.length ? 'block' : 'none';
        });

        partInput.addEventListener('blur', async () => {
            if (selectingSuggestion || validPartSelected) return;
            suggBox.style.display = 'none';

            const value = partInput.value.trim();
            if (!value) return;

            const data = await searchParts(value);
            const match = data.find(p => p.partNumber.toLowerCase() === value.toLowerCase());

            if (match) {
                descInput.value = match.description;
                descInput.style.color = '';
                validPartSelected = true;
            } else {
                descInput.value = 'Part not found in SAP';
                descInput.style.color = '#f87171';
                validPartSelected = false;
            }
        });

        document.addEventListener('click', e => {
            if (!e.target.closest('.part-wrap')) suggBox.style.display = 'none';
        });

        document.querySelector('form').addEventListener('submit', e => {
            if (!validPartSelected) {
                e.preventDefault();
                SiteModal.alert(
                    'Please select a valid SAP part number from the suggestions before submitting.',
                    'Invalid Part Number'
                );
            }
        });

        // File upload zone
        const fileZone     = document.getElementById('fileZone');
        const fileInput    = document.getElementById('fileInput');
        const fileZoneName = document.getElementById('fileZoneName');
        const preview      = document.getElementById('imagePreview');

        fileZone.addEventListener('dragover', e => { e.preventDefault(); fileZone.classList.add('drag-over'); });
        fileZone.addEventListener('dragleave', () => fileZone.classList.remove('drag-over'));
        fileZone.addEventListener('drop', e => {
            e.preventDefault();
            fileZone.classList.remove('drag-over');
            if (e.dataTransfer.files.length) {
                // DataTransfer.files is read-only — trigger via input
                const dt = new DataTransfer();
                dt.items.add(e.dataTransfer.files[0]);
                fileInput.files = dt.files;
                handleFile(fileInput.files[0]);
            }
        });

        fileInput.addEventListener('change', function () { handleFile(this.files[0]); });

        function handleFile(file) {
            preview.innerHTML = '';
            if (!file) { fileZoneName.textContent = ''; return; }
            fileZoneName.textContent = file.name;

            if (file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = e => {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.cssText = 'max-width:220px;border-radius:8px;border:1px solid var(--border);margin-top:8px;';
                    preview.appendChild(img);
                };
                reader.readAsDataURL(file);
            } else if (file.type === 'application/pdf') {
                preview.innerHTML = `<div style="font-size:12px;color:var(--muted);margin-top:6px;">📄 ${file.name} (PDF)</div>`;
            }
        }
    </script>
}
