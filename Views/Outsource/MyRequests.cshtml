@model List<OutsourceRequestApp.Models.OutsourceRequest>

@{
    ViewData["Title"] = "My Requests";
    int total    = Model.Count;
    int pending  = Model.Count(r => OutsourceRequestApp.Models.RequestStatus.IsPending(r.Status));
    int approved = Model.Count(r => r.Status == OutsourceRequestApp.Models.RequestStatus.Approved);
    int rejected = Model.Count(r => r.Status == OutsourceRequestApp.Models.RequestStatus.Rejected
                                 || r.Status == OutsourceRequestApp.Models.RequestStatus.Cancelled);
}

<div class="page">

    <div class="page-head">
        <div>
            <div class="page-title">My Requests</div>
            <div class="page-sub">Outsource requests submitted by you</div>
        </div>
        <a class="sbtn primary" asp-controller="Outsource" asp-action="Create">+ New Request</a>
    </div>

    <div class="kpi-row" style="grid-template-columns:repeat(4,1fr);">
        <div class="kpi"><div class="kpi-label">Total</div><div class="kpi-val">@total</div></div>
        <div class="kpi"><div class="kpi-label">In Progress</div><div class="kpi-val amber">@pending</div></div>
        <div class="kpi"><div class="kpi-label">Approved</div><div class="kpi-val green">@approved</div></div>
        <div class="kpi"><div class="kpi-label">Rejected</div><div class="kpi-val red">@rejected</div></div>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="empty">
                <p style="margin-bottom:16px;">You haven't submitted any outsource requests yet.</p>
                <a class="sbtn primary" asp-controller="Outsource" asp-action="Create">Create First Request</a>
            </div>
        </div>
    }
    else
    {
        <div class="grid-wrap">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Part</th>
                        <th>Qty</th>
                        <th>Start date</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr onclick="location.href='@Url.Action("Track", "Outsource", new { id = r.RequestId })'">
                            <td>#@r.RequestId.ToString("000000")</td>
                            <td>
                                <div style="font-weight:600;">@r.PartNumber</div>
                                @if (!string.IsNullOrEmpty(r.SapDescription))
                                {
                                    <div style="font-size:11px;color:var(--muted);margin-top:2px;">@r.SapDescription</div>
                                }
                            </td>
                            <td>@r.Quantity</td>
                            <td style="color:var(--muted)">@(r.StartDate.HasValue ? r.StartDate.Value.ToString("dd MMM yy") : "—")</td>
                            <td>
                                <span class="rag @RequestStatus.RagClass(r.Status)">
                                    @RequestStatus.Label(r.Status)
                                </span>
                            </td>
                            <td style="color:var(--muted)">@r.CreatedAt.ToString("dd MMM yy")</td>
                            <td>
                                <button class="sbtn sm"
                                        onclick="event.stopPropagation();location.href='@Url.Action("Track", "Outsource", new { id = r.RequestId })'">
                                    Track →
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
