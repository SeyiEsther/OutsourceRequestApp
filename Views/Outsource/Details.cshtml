@model OutsourceRequestApp.Models.OutsourceRequest
@using OutsourceRequestApp.Models

@{
    ViewData["Title"] = $"OSR-{Model.RequestId:000000}";
    var roles   = ViewBag.Roles as List<ApproverRole> ?? new List<ApproverRole>();
    var sc      = roles.FirstOrDefault(r => r.RoleKey == "SC");
    var finance = roles.FirstOrDefault(r => r.RoleKey == "Finance");
    var md      = roles.FirstOrDefault(r => r.RoleKey == "MD");

    bool scDone  = Model.ScReviewedAt.HasValue;
    bool finDone = Model.FinanceReviewedAt.HasValue;
    bool mdDone  = Model.MdReviewedAt.HasValue;

    string badgeClass = RequestStatus.BadgeClass(Model.Status);
    string statusLabel = RequestStatus.Label(Model.Status);
}

<style>
    .detail-pg { max-width: 860px; margin: 0 auto; padding: 40px 28px 60px; }

    .detail-head {
        display: flex; justify-content: space-between; align-items: flex-start;
        margin-bottom: 32px; gap: 16px; flex-wrap: wrap;
    }
    .d-id    { font-family: var(--mono); font-size: 11px; color: var(--text3); margin-bottom: 5px; }
    .d-title { font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 5px; }
    .d-meta  { font-size: 12px; color: var(--text2); }
    .detail-actions { display: flex; gap: 10px; flex-shrink: 0; align-items: center; flex-wrap: wrap; }

    /* Info grid */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
    .info-label {
        font-size: 10px; text-transform: uppercase; letter-spacing: .08em;
        color: var(--text2); font-weight: 600;
        padding: 10px 20px 10px 0; border-bottom: 1px solid var(--border);
    }
    .info-val {
        font-size: 13px; color: var(--text);
        padding: 10px 0; border-bottom: 1px solid var(--border);
    }
    .info-val.mono { font-family: var(--mono); font-size: 12px; }

    .reason-box {
        background: var(--card2); border-radius: 8px;
        padding: 14px 16px; font-size: 13px;
        line-height: 1.7; color: var(--text);
        margin-top: 14px;
    }

    /* Cost rows */
    .cost-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 13px;
    }
    .cost-row:last-child { border-bottom: none; }
    .cost-label { color: var(--text2); font-size: 12px; }
    .cost-val   { font-family: var(--mono); }

    /* Approval stages */
    .approval-stage {
        display: flex; gap: 14px;
        padding: 14px 0; border-bottom: 1px solid var(--border);
    }
    .approval-stage:last-child { border-bottom: none; }

    .as-ico {
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 600; flex-shrink: 0; margin-top: 1px;
    }
    .asi-done { background: rgba(34,197,94,.1);  color: var(--green); }
    .asi-pend { background: var(--accent-dim);   color: var(--accent); }
    .asi-wait { background: var(--card2);         color: var(--text3); }
    .asi-rej  { background: rgba(239,68,68,.1);  color: #f87171; }

    .as-body { flex: 1; }
    .as-role { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
    .as-who  { font-size: 12px; color: var(--text2); }
    .as-when { font-size: 11px; color: var(--text3); font-family: var(--mono); margin-top: 3px; }
    .as-note { font-size: 12px; color: var(--text2); font-style: italic; margin-top: 4px; }

    /* Stage chip */
    .stage-chip {
        display: inline-flex; align-items: center; gap: 5px;
        font-size: 11px; padding: 3px 11px; border-radius: 999px; white-space: nowrap;
    }
    .chip-done    { background: rgba(34,197,94,.1); color: var(--green); border: 1px solid rgba(34,197,94,.22); }
    .chip-pending { background: var(--accent-dim); color: var(--accent); border: 1px solid rgba(99,102,241,.25); }
    .chip-waiting { background: var(--card2); color: var(--text2); border: 1px solid var(--border2); }
    .chip-rej     { background: rgba(239,68,68,.1); color: #f87171; border: 1px solid rgba(239,68,68,.22); }

    .attachment-link {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; color: var(--accent); text-decoration: none; margin-top: 8px;
    }
    .attachment-link:hover { text-decoration: underline; }

    .attachment-thumb {
        max-width: 260px; border-radius: 8px; border: 1px solid var(--border); margin-top: 8px;
    }

    .footer-actions { margin-top: 28px; display: flex; gap: 10px; flex-wrap: wrap; }
</style>

<div class="detail-pg">

    <a class="back-link" asp-controller="Outsource" asp-action="Index">← All requests</a>

    <div class="detail-head">
        <div>
            <div class="d-id">OSR-@Model.RequestId.ToString("000000")</div>
            <div class="d-title">@(Model.SapDescription ?? Model.PartNumber)</div>
            <div class="d-meta">Submitted @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") by @Model.CreatedByUsername</div>
        </div>
        <div class="detail-actions">
            <span class="badge @badgeClass">@statusLabel</span>
            <a class="btn-primary" asp-controller="Outsource" asp-action="Track" asp-route-id="@Model.RequestId">
                Track →
            </a>
        </div>
    </div>

    <div class="section-label">Request details</div>
    <div class="form-card">
        <div class="info-grid">
            <div class="info-label">Part number</div>
            <div class="info-val mono">@Model.PartNumber</div>

            <div class="info-label">SAP description</div>
            <div class="info-val">@(Model.SapDescription ?? "—")</div>

            <div class="info-label">Drawing number</div>
            <div class="info-val mono">@(Model.DrawingNumber ?? "—")</div>

            <div class="info-label">Quantity</div>
            <div class="info-val mono">@Model.Quantity</div>

            <div class="info-label">Start date</div>
            <div class="info-val">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd MMM yyyy") : "—")</div>

            <div class="info-label">End date</div>
            <div class="info-val">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd MMM yyyy") : "—")</div>
        </div>

        <div style="margin-top:14px;">
            <div class="info-label" style="padding:0;border:none;margin-bottom:8px;">Reason for outsourcing</div>
            <div class="reason-box">@Model.Reason</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
    {
        <div class="section-label">Attachment</div>
        <div class="form-card">
            @{
                var isPdf = Model.AttachmentPath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
            }
            @if (isPdf)
            {
                <a class="attachment-link" href="/@Model.AttachmentPath" target="_blank">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    View PDF attachment
                </a>
            }
            else
            {
                <img class="attachment-thumb" src="/@Model.AttachmentPath" alt="Attached document" />
                <br />
                <a class="attachment-link" href="/@Model.AttachmentPath" target="_blank">Open full size →</a>
            }
        </div>
    }

    @if (Model.CostInhousePerMonth.HasValue || Model.CostOutsourcePerMonth.HasValue || Model.PpapRequired.HasValue)
    {
        <div class="section-label">Supply Chain — cost analysis</div>
        <div class="form-card">
            <div class="cost-row">
                <span class="cost-label">PPAP required?</span>
                <span class="cost-val">@(Model.PpapRequired.HasValue ? (Model.PpapRequired.Value ? "Yes" : "No") : "—")</span>
            </div>
            <div class="cost-row">
                <span class="cost-label">In-house cost / month</span>
                <span class="cost-val">@(Model.CostInhousePerMonth.HasValue ? $"£{Model.CostInhousePerMonth.Value:N2}" : "—")</span>
            </div>
            <div class="cost-row">
                <span class="cost-label">Outsource cost / month</span>
                <span class="cost-val">@(Model.CostOutsourcePerMonth.HasValue ? $"£{Model.CostOutsourcePerMonth.Value:N2}" : "—")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.CostComments))
            {
                <div class="cost-row">
                    <span class="cost-label">Cost notes</span>
                    <span style="font-size:13px;">@Model.CostComments</span>
                </div>
            }
        </div>
    }

    <div class="section-label">Approval history</div>
    <div class="form-card">

        <div class="approval-stage">
            <div class="as-ico asi-done">✓</div>
            <div class="as-body">
                <div class="as-role">Work Preparation — submitted</div>
                <div class="as-who">@Model.CreatedByUsername</div>
                <div class="as-when">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
            <span class="stage-chip chip-done">Submitted</span>
        </div>

        @{
            bool scPend = Model.Status == "Submitted";
            bool scRej  = !scDone && Model.Status == "Rejected";
        }
        <div class="approval-stage">
            <div class="as-ico @(scDone ? "asi-done" : scPend ? "asi-pend" : "asi-wait")">
                @(scDone ? "✓" : scPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Supply Chain Review
                    @if (sc != null && (scDone || scPend))
                    {
                        <span style="font-weight:400;color:var(--text2)"> — @sc.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (scDone)      { <text>Reviewed by @Model.ScReviewedBy</text> }
                    else if (scPend)  { <text>Awaiting review</text> }
                    else              { <text>Not yet reached</text> }
                </div>
                @if (scDone)
                {
                    <div class="as-when">@Model.ScReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.ScComments)) { <div class="as-note">"@Model.ScComments"</div> }
                }
            </div>
            <span class="stage-chip @(scDone ? "chip-done" : scPend ? "chip-pending" : scRej ? "chip-rej" : "chip-waiting")">
                @(scDone ? "Approved" : scPend ? "Pending" : scRej ? "Rejected" : "Waiting")
            </span>
        </div>

        @{
            bool finPend = Model.Status == "Finance_Pending";
        }
        <div class="approval-stage">
            <div class="as-ico @(finDone ? "asi-done" : finPend ? "asi-pend" : "asi-wait")">
                @(finDone ? "✓" : finPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Finance Director sign-off
                    @if (finance != null && (finDone || finPend))
                    {
                        <span style="font-weight:400;color:var(--text2)"> — @finance.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (finDone)      { <text>Reviewed by @Model.FinanceReviewedBy</text> }
                    else if (finPend)  { <text>Awaiting sign-off</text> }
                    else              { <text>Not yet reached</text> }
                </div>
                @if (finDone)
                {
                    <div class="as-when">@Model.FinanceReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.FinanceComments)) { <div class="as-note">"@Model.FinanceComments"</div> }
                }
            </div>
            <span class="stage-chip @(finDone ? "chip-done" : finPend ? "chip-pending" : "chip-waiting")">
                @(finDone ? "Approved" : finPend ? "Pending" : "Waiting")
            </span>
        </div>

        @{
            bool mdPend = Model.Status == "MD_Pending";
        }
        <div class="approval-stage">
            <div class="as-ico @(mdDone && Model.Status == "Approved" ? "asi-done" : mdDone && Model.Status == "Rejected" ? "asi-rej" : mdPend ? "asi-pend" : "asi-wait")">
                @(mdDone && Model.Status == "Approved" ? "✓" : mdDone && Model.Status == "Rejected" ? "✗" : mdPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Managing Director approval
                    @if (md != null && (mdDone || mdPend))
                    {
                        <span style="font-weight:400;color:var(--text2)"> — @md.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (mdDone && Model.Status == "Approved")  { <text>Approved by @Model.MdReviewedBy — outsourcing authorised</text> }
                    else if (mdDone && Model.Status == "Rejected") { <text>Rejected by @Model.MdReviewedBy</text> }
                    else if (mdPend)                            { <text>Awaiting final decision</text> }
                    else                                        { <text>Not yet reached</text> }
                </div>
                @if (mdDone)
                {
                    <div class="as-when">@Model.MdReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.MdComments)) { <div class="as-note">"@Model.MdComments"</div> }
                }
            </div>
            <span class="stage-chip @(mdDone && Model.Status == "Approved" ? "chip-done" : mdDone && Model.Status == "Rejected" ? "chip-rej" : mdPend ? "chip-pending" : "chip-waiting")">
                @(mdDone && Model.Status == "Approved" ? "Approved" : mdDone && Model.Status == "Rejected" ? "Rejected" : mdPend ? "Pending" : "Waiting")
            </span>
        </div>

    </div>

    <div class="footer-actions">
        <a class="btn-ghost" asp-controller="Outsource" asp-action="Index">← All requests</a>
        <a class="btn-primary" asp-controller="Outsource" asp-action="Track" asp-route-id="@Model.RequestId">
            Open tracker →
        </a>
    </div>

</div>
