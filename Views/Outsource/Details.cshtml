@model OutsourceRequestApp.Models.OutsourceRequest
@using OutsourceRequestApp.Models

@{
    ViewData["Title"] = $"OSR-{Model.RequestId:000000}";
    var roles    = ViewBag.Roles as List<ApproverRole> ?? new List<ApproverRole>();
    var wp       = roles.FirstOrDefault(r => r.RoleKey == "WP");
    var prod     = roles.FirstOrDefault(r => r.RoleKey == "PROD");
    var buyer    = roles.FirstOrDefault(r => r.RoleKey == "BUYER");
    var sourcing = roles.FirstOrDefault(r => r.RoleKey == "SOURCING");
    var md       = roles.FirstOrDefault(r => r.RoleKey == "MD");

    bool wpDone       = Model.JFSignedDate.HasValue;
    bool prodDone     = Model.LJSignedDate.HasValue;
    bool scDone       = Model.ScReviewedAt.HasValue;
    bool sourcingDone = Model.SGSignedDate.HasValue;
    bool mdDone       = Model.MdReviewedAt.HasValue;

    string ragClass = RequestStatus.RagClass(Model.Status);
    string statusLabel = RequestStatus.Label(Model.Status);
}

<style>
    .detail-head {
        display: flex; justify-content: space-between; align-items: flex-start;
        margin-bottom: 24px; gap: 16px; flex-wrap: wrap;
    }
    .d-id    { font-size: 11px; color: var(--muted); margin-bottom: 5px; font-weight: 600; letter-spacing: .04em; }
    .d-title { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 5px; }
    .d-meta  { font-size: 12px; color: var(--muted); }
    .detail-actions { display: flex; gap: 10px; flex-shrink: 0; align-items: center; flex-wrap: wrap; }

    /* Info grid */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
    .info-label {
        font-size: 10px; text-transform: uppercase; letter-spacing: .08em;
        color: var(--muted); font-weight: 600;
        padding: 10px 20px 10px 0; border-bottom: 1px solid var(--border);
    }
    .info-val { font-size: 13px; color: var(--ink); padding: 10px 0; border-bottom: 1px solid var(--border); }

    .reason-box {
        background: var(--surface); border-radius: 8px;
        padding: 14px 16px; font-size: 13px;
        line-height: 1.7; color: var(--ink); margin-top: 14px;
    }

    /* Cost rows */
    .cost-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 9px 0; border-bottom: 1px solid var(--border); font-size: 13px;
    }
    .cost-row:last-child { border-bottom: none; }
    .cost-label { color: var(--muted); font-size: 12px; }

    /* Approval stages */
    .approval-stage { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border); }
    .approval-stage:last-child { border-bottom: none; }

    .as-ico {
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 700; flex-shrink: 0; margin-top: 1px;
    }
    .asi-done { background: var(--green-bg); color: var(--green); }
    .asi-pend { background: var(--accent-soft); color: var(--accent); }
    .asi-wait { background: var(--surface); color: var(--muted); }
    .asi-rej  { background: var(--red-bg); color: var(--red-text); }

    .as-body { flex: 1; }
    .as-role { font-size: 13px; font-weight: 700; margin-bottom: 2px; color: var(--ink); }
    .as-who  { font-size: 12px; color: var(--muted); }
    .as-when { font-size: 11px; color: var(--muted); margin-top: 3px; }
    .as-note { font-size: 12px; color: var(--muted); font-style: italic; margin-top: 4px; }

    .attachment-link {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; color: var(--accent); text-decoration: none; margin-top: 8px; font-weight: 600;
    }
    .attachment-link:hover { text-decoration: underline; }
    .attachment-thumb { max-width: 260px; border-radius: 8px; border: 1px solid var(--border); margin-top: 8px; }

    .footer-actions { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; }
</style>

<div class="wrap">

    <a class="back-link" asp-controller="Outsource" asp-action="Index">← All requests</a>

    <div class="detail-head">
        <div>
            <div class="d-id">OSR-@Model.RequestId.ToString("000000")</div>
            <div class="d-title">@(Model.SapDescription ?? Model.PartNumber)</div>
            <div class="d-meta">Submitted @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") by @Model.CreatedByUsername</div>
        </div>
        <div class="detail-actions">
            <span class="rag @ragClass">@statusLabel</span>
            <a class="sbtn primary" asp-controller="Outsource" asp-action="Track" asp-route-id="@Model.RequestId">Track →</a>
        </div>
    </div>

    <div class="section-label">Request details</div>
    <div class="card"><div class="card-body">
        <div class="info-grid">
            <div class="info-label">Part number</div>
            <div class="info-val">@Model.PartNumber</div>

            <div class="info-label">SAP description</div>
            <div class="info-val">@(Model.SapDescription ?? "—")</div>

            <div class="info-label">Drawing number</div>
            <div class="info-val">@(Model.DrawingNumber ?? "—")</div>

            <div class="info-label">Quantity</div>
            <div class="info-val">@Model.Quantity</div>

            <div class="info-label">Start date</div>
            <div class="info-val">@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("dd MMM yyyy") : "—")</div>

            <div class="info-label">End date</div>
            <div class="info-val">@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd MMM yyyy") : "—")</div>
        </div>

        <div style="margin-top:14px;">
            <div class="info-label" style="padding:0;border:none;margin-bottom:8px;">Reason for outsourcing</div>
            <div class="reason-box">@Model.Reason</div>
        </div>
    </div></div>

    @if (!string.IsNullOrEmpty(Model.AttachmentPath))
    {
        <div class="section-label">Attachment</div>
        <div class="card"><div class="card-body">
            @{
                var isPdf = Model.AttachmentPath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
            }
            @if (isPdf)
            {
                <a class="attachment-link" href="/@Model.AttachmentPath" target="_blank">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    View PDF attachment
                </a>
            }
            else
            {
                <img class="attachment-thumb" src="/@Model.AttachmentPath" alt="Attached document" />
                <br />
                <a class="attachment-link" href="/@Model.AttachmentPath" target="_blank">Open full size →</a>
            }
        </div></div>
    }

    @if (Model.CostInhousePerMonth.HasValue || Model.CostOutsourcePerMonth.HasValue || Model.PpapRequired.HasValue)
    {
        <div class="section-label">Supply Chain — cost analysis</div>
        <div class="card"><div class="card-body">
            <div class="cost-row">
                <span class="cost-label">PPAP required?</span>
                <span>@(Model.PpapRequired.HasValue ? (Model.PpapRequired.Value ? "Yes" : "No") : "—")</span>
            </div>
            <div class="cost-row">
                <span class="cost-label">In-house cost / month</span>
                <span>@(Model.CostInhousePerMonth.HasValue ? $"£{Model.CostInhousePerMonth.Value:N2}" : "—")</span>
            </div>
            <div class="cost-row">
                <span class="cost-label">Outsource cost / month</span>
                <span>@(Model.CostOutsourcePerMonth.HasValue ? $"£{Model.CostOutsourcePerMonth.Value:N2}" : "—")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.CostComments))
            {
                <div class="cost-row">
                    <span class="cost-label">Cost notes</span>
                    <span style="font-size:13px;">@Model.CostComments</span>
                </div>
            }
        </div></div>
    }

    <div class="section-label">Approval history</div>
    <div class="card"><div class="card-body">

        <div class="approval-stage">
            <div class="as-ico asi-done">✓</div>
            <div class="as-body">
                <div class="as-role">Work Preparation — submitted</div>
                <div class="as-who">@Model.CreatedByUsername</div>
                <div class="as-when">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
            <span class="rag g">Submitted</span>
        </div>

        @{
            bool wpPend = Model.Status == RequestStatus.Submitted;
            bool wpRej  = !wpDone && Model.Status == RequestStatus.Rejected;
        }
        <div class="approval-stage">
            <div class="as-ico @(wpDone ? "asi-done" : wpPend ? "asi-pend" : "asi-wait")">
                @(wpDone ? "✓" : wpPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Work Preparation
                    @if (wp != null && (wpDone || wpPend))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @wp.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (wpDone)      { <text>Signed by @Model.JFSignedBy</text> }
                    else if (wpPend)  { <text>Awaiting sign-off</text> }
                    else              { <text>Not yet reached</text> }
                </div>
                @if (wpDone)
                {
                    <div class="as-when">@Model.JFSignedDate?.ToString("dd MMM yyyy, HH:mm")</div>
                }
            </div>
            <span class="rag @(wpDone ? "g" : wpPend ? "u" : wpRej ? "r" : "u")">
                @(wpDone ? "Approved" : wpPend ? "Pending" : wpRej ? "Rejected" : "Waiting")
            </span>
        </div>

        @{
            bool prodPend = Model.Status == RequestStatus.ProductionPending;
        }
        <div class="approval-stage">
            <div class="as-ico @(prodDone ? "asi-done" : prodPend ? "asi-pend" : "asi-wait")">
                @(prodDone ? "✓" : prodPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Production
                    @if (prod != null && (prodDone || prodPend))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @prod.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (prodDone)      { <text>Signed by @Model.LJSignedBy</text> }
                    else if (prodPend)  { <text>Awaiting sign-off</text> }
                    else              { <text>Not yet reached</text> }
                </div>
                @if (prodDone)
                {
                    <div class="as-when">@Model.LJSignedDate?.ToString("dd MMM yyyy, HH:mm")</div>
                }
            </div>
            <span class="rag @(prodDone ? "g" : prodPend ? "u" : "u")">
                @(prodDone ? "Approved" : prodPend ? "Pending" : "Waiting")
            </span>
        </div>

        @{
            bool buyerPend = Model.Status == RequestStatus.CostCompactPending;
        }
        <div class="approval-stage">
            <div class="as-ico @(scDone ? "asi-done" : buyerPend ? "asi-pend" : "asi-wait")">
                @(scDone ? "✓" : buyerPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Cost Compact — Strategic Buyer
                    @if (buyer != null && (scDone || buyerPend))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @buyer.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (scDone)        { <text>Reviewed by @Model.ScReviewedBy</text> }
                    else if (buyerPend) { <text>Awaiting review</text> }
                    else                { <text>Not yet reached</text> }
                </div>
                @if (scDone)
                {
                    <div class="as-when">@Model.ScReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.ScComments)) { <div class="as-note">"@Model.ScComments"</div> }
                }
            </div>
            <span class="rag @(scDone ? "g" : buyerPend ? "u" : "u")">
                @(scDone ? "Approved" : buyerPend ? "Pending" : "Waiting")
            </span>
        </div>

        @{
            bool sourcingPend = Model.Status == RequestStatus.SourcingPending;
        }
        <div class="approval-stage">
            <div class="as-ico @(sourcingDone ? "asi-done" : sourcingPend ? "asi-pend" : "asi-wait")">
                @(sourcingDone ? "✓" : sourcingPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Sourcing &amp; Procurement
                    @if (sourcing != null && (sourcingDone || sourcingPend))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @sourcing.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (sourcingDone)      { <text>Signed by @Model.SGSignedBy</text> }
                    else if (sourcingPend)  { <text>Awaiting sign-off</text> }
                    else              { <text>Not yet reached</text> }
                </div>
                @if (sourcingDone)
                {
                    <div class="as-when">@Model.SGSignedDate?.ToString("dd MMM yyyy, HH:mm")</div>
                }
            </div>
            <span class="rag @(sourcingDone ? "g" : sourcingPend ? "u" : "u")">
                @(sourcingDone ? "Approved" : sourcingPend ? "Pending" : "Waiting")
            </span>
        </div>

        @{
            bool mdPend = Model.Status == RequestStatus.MdPending;
        }
        <div class="approval-stage">
            <div class="as-ico @(mdDone && Model.Status == "Approved" ? "asi-done" : mdDone && Model.Status == "Rejected" ? "asi-rej" : mdPend ? "asi-pend" : "asi-wait")">
                @(mdDone && Model.Status == "Approved" ? "✓" : mdDone && Model.Status == "Rejected" ? "✗" : mdPend ? "→" : "–")
            </div>
            <div class="as-body">
                <div class="as-role">
                    Managing Director approval
                    @if (md != null && (mdDone || mdPend))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @md.FullName</span>
                    }
                </div>
                <div class="as-who">
                    @if (mdDone && Model.Status == "Approved")  { <text>Approved by @Model.MdReviewedBy — outsourcing authorised</text> }
                    else if (mdDone && Model.Status == "Rejected") { <text>Rejected by @Model.MdReviewedBy</text> }
                    else if (mdPend)                            { <text>Awaiting final decision</text> }
                    else                                        { <text>Not yet reached</text> }
                </div>
                @if (mdDone)
                {
                    <div class="as-when">@Model.MdReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.MdComments)) { <div class="as-note">"@Model.MdComments"</div> }
                }
            </div>
            <span class="rag @(mdDone && Model.Status == "Approved" ? "g" : mdDone && Model.Status == "Rejected" ? "r" : mdPend ? "u" : "u")">
                @(mdDone && Model.Status == "Approved" ? "Approved" : mdDone && Model.Status == "Rejected" ? "Rejected" : mdPend ? "Pending" : "Waiting")
            </span>
        </div>

    </div></div>

    <div class="footer-actions">
        <a class="sbtn" asp-controller="Outsource" asp-action="Index">← All requests</a>
        <a class="sbtn primary" asp-controller="Outsource" asp-action="Track" asp-route-id="@Model.RequestId">Open tracker →</a>
    </div>

</div>
