@model List<OutsourceRequestApp.Models.OutsourceRequest>

@{
    ViewData["Title"] = "All Requests";

    int totalAll       = (int)(ViewBag.TotalAll       ?? 0);
    int totalSubmitted = (int)(ViewBag.TotalSubmitted  ?? 0);
    int totalReview    = (int)(ViewBag.TotalReview     ?? 0);
    int totalApproved  = (int)(ViewBag.TotalApproved   ?? 0);
    int totalRejected  = (int)(ViewBag.TotalRejected   ?? 0);

    int    currentPage   = (int)(ViewBag.CurrentPage   ?? 1);
    int    totalPages    = (int)(ViewBag.TotalPages     ?? 1);
    int    totalFiltered = (int)(ViewBag.TotalFiltered  ?? 0);
    string currentStatus = (string)(ViewBag.CurrentStatus ?? "all");
    string currentQ      = (string)(ViewBag.CurrentQ      ?? "");
}

<style>
    .index-wrap {
        max-width: 1120px;
        margin: 0 auto;
        padding: 44px 28px 60px;
    }

    .index-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 32px;
        gap: 16px;
        flex-wrap: wrap;
    }

        .index-header h2 { font-size: 22px; font-weight: 500; margin-bottom: 5px; }
        .index-header p  { font-size: 13px; color: var(--muted); }

    .header-actions { display: flex; gap: 10px; flex-shrink: 0; align-items: center; }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 28px;
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px 18px;
        cursor: pointer;
        transition: border-color .15s;
        text-decoration: none;
        display: block;
    }

        .stat-card:hover  { border-color: var(--border2); }
        .stat-card.s-active { border-color: var(--red); }

    .stat-label {
        font-size: 10px; text-transform: uppercase;
        letter-spacing: .08em; color: var(--muted);
        margin-bottom: 10px; font-weight: 500;
    }

    .stat-val {
        font-size: 26px; font-weight: 400;
        color: var(--text); font-family: var(--mono);
    }

        .stat-val.c-red   { color: #ff4d58; }
        .stat-val.c-amber { color: #fbbf24; }
        .stat-val.c-green { color: #4ade80; }
        .stat-val.c-gray  { color: #f87171; }

    .toolbar {
        display: flex; gap: 10px;
        margin-bottom: 20px; align-items: center; flex-wrap: wrap;
    }

    .search-wrap {
        flex: 1; min-width: 200px;
        display: flex; align-items: center; gap: 8px;
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 8px; padding: 8px 12px;
    }

        .search-wrap input {
            background: transparent; border: none;
            color: var(--text); font-size: 13px;
            outline: none; flex: 1; font-family: var(--font);
        }

    .search-ico { color: var(--muted); font-size: 15px; }

    .btn-search {
        padding: 8px 16px; background: var(--surface);
        border: 1px solid var(--border2); border-radius: 8px;
        color: var(--text); font-size: 13px; cursor: pointer;
        font-family: var(--font); transition: background .15s;
        white-space: nowrap; text-decoration: none; display: inline-block;
    }

        .btn-search:hover { background: var(--surface2); color: var(--text); }

    .table-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }

    table { width: 100%; border-collapse: collapse; }
    thead { background: #0f0f11; }

    th {
        text-align: left; padding: 11px 16px;
        font-size: 10px; letter-spacing: .08em;
        text-transform: uppercase; color: var(--muted);
        border-bottom: 1px solid var(--border);
        font-weight: 500; white-space: nowrap;
    }

    td {
        padding: 14px 16px; border-bottom: 1px solid var(--border);
        font-size: 13px; color: var(--text); vertical-align: middle;
    }

    tbody tr { cursor: pointer; transition: background .12s; }
        tbody tr:hover        { background: var(--surface2); }
        tbody tr:last-child td { border-bottom: none; }

    .mono-sm   { font-family: var(--mono); font-size: 12px; color: var(--muted); }
    .part-num  { font-family: var(--mono); font-size: 12px; }
    .part-desc { font-size: 11px; color: var(--muted); margin-top: 2px; }

    .track-btn {
        padding: 5px 14px; border-radius: 999px; font-size: 12px;
        font-weight: 500; background: transparent;
        border: 1px solid var(--border2); color: var(--text);
        cursor: pointer; transition: all .15s; font-family: var(--font);
    }

        .track-btn:hover { background: var(--red); border-color: var(--red); color: #fff; }

    .empty-state { padding: 60px 40px; text-align: center; color: var(--muted); }
        .empty-state p { margin-bottom: 20px; font-size: 14px; }

    /* Pagination */
    .pagination {
        display: flex; align-items: center;
        justify-content: space-between;
        padding: 14px 20px; border-top: 1px solid var(--border);
        font-size: 12px; color: var(--muted);
        flex-wrap: wrap; gap: 10px;
    }

    .page-btns { display: flex; gap: 6px; }

    .page-btn {
        padding: 5px 14px; border: 1px solid var(--border2);
        border-radius: 7px; background: transparent;
        color: var(--text); font-size: 12px; cursor: pointer;
        text-decoration: none; font-family: var(--font);
        transition: all .15s; display: inline-block;
    }

        .page-btn:hover         { background: var(--surface2); color: var(--text); }
        .page-btn.p-active      { background: var(--red); border-color: var(--red); color: #fff; }
        .page-btn.p-disabled    { opacity: .35; pointer-events: none; }
</style>

<div class="index-wrap">

    <div class="index-header">
        <div>
            <h2>All Requests</h2>
            <p>Sheet metal outsourcing requests across all statuses</p>
        </div>
        <div class="header-actions">
            <a class="btn-ghost" asp-action="Export" title="Download all requests as CSV">↓ Export CSV</a>
            <a class="btn-primary" asp-action="Create">+ New Request</a>
        </div>
    </div>

    <!-- Clickable stat cards double as filter shortcuts -->
    <div class="stats-row">
        <a class="stat-card @(currentStatus == "all" ? "s-active" : "")"
           href="@Url.Action("Index", new { status = "all", q = currentQ })">
            <div class="stat-label">Total</div>
            <div class="stat-val">@totalAll</div>
        </a>
        <a class="stat-card @(currentStatus == "submitted" ? "s-active" : "")"
           href="@Url.Action("Index", new { status = "submitted", q = currentQ })">
            <div class="stat-label">Submitted</div>
            <div class="stat-val c-red">@totalSubmitted</div>
        </a>
        <a class="stat-card @(currentStatus == "review" ? "s-active" : "")"
           href="@Url.Action("Index", new { status = "review", q = currentQ })">
            <div class="stat-label">In Review</div>
            <div class="stat-val c-amber">@totalReview</div>
        </a>
        <a class="stat-card @(currentStatus == "approved" ? "s-active" : "")"
           href="@Url.Action("Index", new { status = "approved", q = currentQ })">
            <div class="stat-label">Approved</div>
            <div class="stat-val c-green">@totalApproved</div>
        </a>
        <a class="stat-card @(currentStatus == "rejected" ? "s-active" : "")"
           href="@Url.Action("Index", new { status = "rejected", q = currentQ })">
            <div class="stat-label">Rejected</div>
            <div class="stat-val c-gray">@totalRejected</div>
        </a>
    </div>

    <!-- Server-side search -->
    <form class="toolbar" method="get" asp-action="Index">
        <input type="hidden" name="status" value="@currentStatus" />
        <div class="search-wrap">
            <span class="search-ico">⌕</span>
            <input name="q" value="@currentQ"
                   placeholder="Search by part number, ID, description or submitter…" />
        </div>
        <button type="submit" class="btn-search">Search</button>
        @if (!string.IsNullOrEmpty(currentQ))
        {
            <a class="btn-search" href="@Url.Action("Index", new { status = currentStatus })">✕ Clear</a>
        }
    </form>

    @if (!Model.Any())
    {
        <div class="table-card">
            <div class="empty-state">
                @if (!string.IsNullOrEmpty(currentQ) || currentStatus != "all")
                {
                    <p>No requests match your current filter.</p>
                    <a class="btn-primary" asp-action="Index">Clear filters</a>
                }
                else
                {
                    <p>No outsource requests have been submitted yet.</p>
                    <a class="btn-primary" asp-action="Create">Create First Request</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Part</th>
                        <th>Submitted by</th>
                        <th>Qty</th>
                        <th>Start</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr onclick="location.href='@Url.Action("Track","Outsource",new{id=r.RequestId})'">
                            <td><span class="mono-sm">#@r.RequestId.ToString("000000")</span></td>
                            <td>
                                <div class="part-num">@r.PartNumber</div>
                                @if (!string.IsNullOrEmpty(r.SapDescription))
                                {
                                    <div class="part-desc">@r.SapDescription</div>
                                }
                            </td>
                            <td style="font-size:12px;color:var(--muted);">@r.CreatedByUsername</td>
                            <td>@r.Quantity</td>
                            <td style="font-size:12px;">
                                @(r.StartDate.HasValue ? r.StartDate.Value.ToString("dd MMM yyyy") : "—")
                            </td>
                            <td>
                                <span class="badge @RequestStatus.BadgeClass(r.Status)">
                                    @RequestStatus.Label(r.Status)
                                </span>
                            </td>
                            <td style="font-size:12px;color:var(--muted);">
                                @r.CreatedAt.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <button class="track-btn"
                                        onclick="event.stopPropagation();location.href='@Url.Action("Track","Outsource",new{id=r.RequestId})'">
                                    Track
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="pagination">
                    <span>
                        Showing @(((currentPage - 1) * 25) + 1)–@(Math.Min(currentPage * 25, totalFiltered))
                        of @totalFiltered result@(totalFiltered != 1 ? "s" : "")
                    </span>
                    <div class="page-btns">
                        <a class="page-btn @(currentPage <= 1 ? "p-disabled" : "")"
                           href="@Url.Action("Index", new { status = currentStatus, q = currentQ, page = currentPage - 1 })">
                            ← Prev
                        </a>
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <a class="page-btn @(p == currentPage ? "p-active" : "")"
                               href="@Url.Action("Index", new { status = currentStatus, q = currentQ, page = p })">
                                @p
                            </a>
                        }
                        <a class="page-btn @(currentPage >= totalPages ? "p-disabled" : "")"
                           href="@Url.Action("Index", new { status = currentStatus, q = currentQ, page = currentPage + 1 })">
                            Next →
                        </a>
                    </div>
                </div>
            }
        </div>
    }

</div>
