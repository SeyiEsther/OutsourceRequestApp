@model List<OutsourceRequestApp.Models.OutsourceRequest>

@{
    ViewData["Title"] = "All Requests";
    int totalAll       = (int)(ViewBag.TotalAll       ?? 0);
    int totalSubmitted = (int)(ViewBag.TotalSubmitted  ?? 0);
    int totalReview    = (int)(ViewBag.TotalReview     ?? 0);
    int totalApproved  = (int)(ViewBag.TotalApproved   ?? 0);
    int totalRejected  = (int)(ViewBag.TotalRejected   ?? 0);
    int    currentPage   = (int)(ViewBag.CurrentPage   ?? 1);
    int    totalPages    = (int)(ViewBag.TotalPages     ?? 1);
    int    totalFiltered = (int)(ViewBag.TotalFiltered  ?? 0);
    string currentStatus = (string)(ViewBag.CurrentStatus ?? "all");
    string currentQ      = (string)(ViewBag.CurrentQ      ?? "");
}

<style>
    .pager {
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px 18px; border-top: 1px solid var(--border);
        font-size: 12px; color: var(--muted);
        flex-wrap: wrap; gap: 10px;
    }
    .pager-btns { display: flex; gap: 5px; }
    .pager-btn {
        padding: 5px 13px; border: 1px solid var(--border);
        border-radius: 7px; background: var(--white);
        color: var(--ink); font-size: 12px; cursor: pointer;
        text-decoration: none; font-family: inherit;
        transition: all var(--dur-fast) var(--ease-ios); display: inline-block;
    }
    .pager-btn:hover     { background: var(--surface); }
    .pager-btn.cur       { background: var(--red); border-color: var(--red); color: #fff; }
    .pager-btn.disabled  { opacity: .35; pointer-events: none; }

    @@media (max-width: 768px) {
        .grid-wrap table { min-width: 640px; }
    }
</style>

<div class="page">

    <div class="page-head">
        <div>
            <div class="page-title">All Requests</div>
            <div class="page-sub">Sheet metal outsourcing requests across all statuses</div>
        </div>
        <div style="display:flex;gap:10px;">
            <a class="sbtn" asp-action="Export">⬇ Export CSV</a>
            <a class="sbtn primary" asp-action="Create">+ New Request</a>
        </div>
    </div>

    <div class="kpi-row">
        <a class="kpi @(currentStatus == "all"       ? "active" : "")" href="@Url.Action("Index", new { status = "all",       q = currentQ })">
            <div class="kpi-label">Total</div><div class="kpi-val">@totalAll</div>
        </a>
        <a class="kpi @(currentStatus == "submitted" ? "active" : "")" href="@Url.Action("Index", new { status = "submitted", q = currentQ })">
            <div class="kpi-label">Submitted</div><div class="kpi-val">@totalSubmitted</div>
        </a>
        <a class="kpi @(currentStatus == "review"    ? "active" : "")" href="@Url.Action("Index", new { status = "review",    q = currentQ })">
            <div class="kpi-label">In Review</div><div class="kpi-val amber">@totalReview</div>
        </a>
        <a class="kpi @(currentStatus == "approved"  ? "active" : "")" href="@Url.Action("Index", new { status = "approved",  q = currentQ })">
            <div class="kpi-label">Approved</div><div class="kpi-val green">@totalApproved</div>
        </a>
        <a class="kpi @(currentStatus == "rejected"  ? "active" : "")" href="@Url.Action("Index", new { status = "rejected",  q = currentQ })">
            <div class="kpi-label">Rejected</div><div class="kpi-val red">@totalRejected</div>
        </a>
    </div>

    <div class="card card-filter">
        <form class="filters" method="get" asp-action="Index">
            <input type="hidden" name="status" value="@currentStatus" />
            <div class="ff" style="flex:1;min-width:240px;">
                <label class="ff-label">Search</label>
                <input id="search-input" class="ff-input" name="q" value="@currentQ"
                       placeholder="Part number, ID, description or submitter…  (press / to focus)" />
            </div>
            <div class="filter-actions">
                <button type="submit" class="sbtn">Search</button>
                @if (!string.IsNullOrEmpty(currentQ))
                {
                    <a class="sbtn" href="@Url.Action("Index", new { status = currentStatus })">✕ Clear</a>
                }
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card">
            <div class="empty">
                @if (!string.IsNullOrEmpty(currentQ) || currentStatus != "all")
                {
                    <p style="margin-bottom:16px;">No requests match your current filter.</p>
                    <a class="sbtn" asp-action="Index">Clear filters</a>
                }
                else
                {
                    <p style="margin-bottom:16px;">No outsource requests have been submitted yet.</p>
                    <a class="sbtn primary" asp-action="Create">Create First Request</a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="grid-wrap">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Part</th>
                        <th>Submitter</th>
                        <th>Qty</th>
                        <th>Start date</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr onclick="location.href='@Url.Action("Track","Outsource",new{id=r.RequestId})'">
                            <td>#@r.RequestId.ToString("000000")</td>
                            <td>
                                <div style="font-weight:600;">@r.PartNumber</div>
                                @if (!string.IsNullOrEmpty(r.SapDescription))
                                {
                                    <div style="font-size:11px;color:var(--muted);margin-top:2px;">@r.SapDescription</div>
                                }
                            </td>
                            <td style="color:var(--muted)">@r.CreatedByUsername</td>
                            <td>@r.Quantity</td>
                            <td style="color:var(--muted)">@(r.StartDate.HasValue ? r.StartDate.Value.ToString("dd MMM yy") : "—")</td>
                            <td>
                                <span class="rag @RequestStatus.RagClass(r.Status)">
                                    @RequestStatus.Label(r.Status)
                                </span>
                            </td>
                            <td style="color:var(--muted)">@r.CreatedAt.ToString("dd MMM yy")</td>
                            <td>
                                <button class="sbtn sm"
                                        onclick="event.stopPropagation();location.href='@Url.Action("Track","Outsource",new{id=r.RequestId})'">
                                    Track →
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <div class="pager">
                    <span>
                        @(((currentPage - 1) * 25) + 1)–@(Math.Min(currentPage * 25, totalFiltered))
                        of @totalFiltered result@(totalFiltered != 1 ? "s" : "")
                    </span>
                    <div class="pager-btns">
                        <a class="pager-btn @(currentPage <= 1 ? "disabled" : "")"
                           href="@Url.Action("Index", new { status = currentStatus, q = currentQ, page = currentPage - 1 })">← Prev</a>
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <a class="pager-btn @(p == currentPage ? "cur" : "")"
                               href="@Url.Action("Index", new { status = currentStatus, q = currentQ, page = p })">@p</a>
                        }
                        <a class="pager-btn @(currentPage >= totalPages ? "disabled" : "")"
                           href="@Url.Action("Index", new { status = currentStatus, q = currentQ, page = currentPage + 1 })">Next →</a>
                    </div>
                </div>
            }
        </div>
    }

</div>

@section Scripts {
    <script>
        document.addEventListener('keydown', e => {
            if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
                e.preventDefault();
                const inp = document.getElementById('search-input');
                if (inp) { inp.focus(); inp.select(); }
            }
        });
    </script>
}
