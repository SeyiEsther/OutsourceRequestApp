@model OutsourceRequestApp.Models.OutsourceRequest
@using OutsourceRequestApp.Models

@{
    ViewData["Title"] = $"Track OSR-{Model.RequestId:000000}";
    var roles = ViewBag.Roles as List<ApproverRole> ?? new List<ApproverRole>();
    var currentUser = ViewBag.CurrentUsername as string ?? "";

    var wp       = roles.FirstOrDefault(r => r.RoleKey == "WP");
    var prod     = roles.FirstOrDefault(r => r.RoleKey == "PROD");
    var buyer    = roles.FirstOrDefault(r => r.RoleKey == "BUYER");
    var sourcing = roles.FirstOrDefault(r => r.RoleKey == "SOURCING");
    var md       = roles.FirstOrDefault(r => r.RoleKey == "MD");

    bool wpDone       = Model.JFSignedDate.HasValue;
    bool prodDone     = Model.LJSignedDate.HasValue;
    bool buyerDone    = Model.ScReviewedAt.HasValue;
    bool sourcingDone = Model.SGSignedDate.HasValue;
    bool mdDone       = Model.MdReviewedAt.HasValue;

    bool wpPending       = Model.Status == RequestStatus.Submitted;
    bool prodPending     = Model.Status == RequestStatus.ProductionPending;
    bool buyerPending    = Model.Status == RequestStatus.CostCompactPending;
    bool sourcingPending = Model.Status == RequestStatus.SourcingPending;
    bool mdPending       = Model.Status == RequestStatus.MdPending;

    // Computed server-side by AccessControlService (email match, with an AD
    // display-name fallback) rather than a raw e-mail compare here, so the
    // approve/reject form's visibility always agrees with what the POST
    // handlers actually authorise.
    bool isWpApprover       = ViewBag.IsWpApprover;
    bool isProdApprover     = ViewBag.IsProdApprover;
    bool isBuyerApprover    = ViewBag.IsBuyerApprover;
    bool isSourcingApprover = ViewBag.IsSourcingApprover;
    bool isMdApprover       = ViewBag.IsMdApprover;

    string ragClass  = RequestStatus.RagClass(Model.Status);
    string badgeLabel = RequestStatus.Label(Model.Status);
    bool isCancelled  = Model.Status == RequestStatus.Cancelled;
    bool isRejected   = Model.Status == RequestStatus.Rejected;
    bool isApproved   = Model.Status == RequestStatus.Approved;
    bool canWithdraw  = Model.Status == RequestStatus.Submitted &&
                        currentUser.Equals(Model.CreatedByUsername, StringComparison.OrdinalIgnoreCase);

    var waiting = DateTime.Now - Model.CreatedAt;
    string waitingStr = waiting.TotalDays >= 1
        ? $"{(int)waiting.TotalDays}d {waiting.Hours}h"
        : $"{waiting.Hours}h {waiting.Minutes}m";

    // Helper to compute step bar state for any stage given its done/pending flags,
    // accounting for the request having been rejected at or before that stage.
    string StepClass(bool done, bool pending, bool rejectedHere)
    {
        if (rejectedHere) return "s-rejected";
        if (done) return "s-done";
        if (pending) return "s-active";
        return "";
    }

    // Did rejection happen at a stage that hasn't "done" its sign yet (i.e. this is the stage that rejected)?
    bool wpRejectedHere       = isRejected && Model.RejectedBy != null && wp       != null && Model.RejectedBy.Equals(wp.Email, StringComparison.OrdinalIgnoreCase)       && !prodDone;
    bool prodRejectedHere     = isRejected && Model.RejectedBy != null && prod     != null && Model.RejectedBy.Equals(prod.Email, StringComparison.OrdinalIgnoreCase)     && !buyerDone;
    bool buyerRejectedHere    = isRejected && Model.RejectedBy != null && buyer    != null && Model.RejectedBy.Equals(buyer.Email, StringComparison.OrdinalIgnoreCase)    && !sourcingDone;
    bool sourcingRejectedHere = isRejected && Model.RejectedBy != null && sourcing != null && Model.RejectedBy.Equals(sourcing.Email, StringComparison.OrdinalIgnoreCase) && !mdDone;
    bool mdRejectedHere       = isRejected && mdDone;
}

<style>
    .track-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }

    .track-hero {
        background: var(--white); border: 1px solid var(--border);
        border-radius: 14px; padding: 22px 24px; margin-bottom: 20px;
        box-shadow: 0 1px 3px rgba(15,17,23,.04);
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 20px; flex-wrap: wrap;
    }
    .req-id    { font-size: 11px; color: var(--muted); margin-bottom: 5px; font-weight: 600; letter-spacing: .04em; }
    .req-title { font-size: 20px; font-weight: 700; letter-spacing: -0.01em; }
    .req-meta  { font-size: 12px; color: var(--muted); margin-top: 6px; line-height: 1.7; }

    .hero-right { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }

    /* Step bar */
    .steps { display: flex; align-items: flex-start; margin-bottom: 22px; position: relative; }
    .step { flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 1; }
    .step:not(:last-child)::after {
        content: ''; position: absolute; top: 19px; left: 50%; right: -50%;
        height: 2px; background: var(--border); z-index: 0;
    }
    .step:not(:last-child).s-done::after { background: var(--green); }

    .step-dot {
        width: 34px; height: 34px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 700;
        border: 2px solid var(--border);
        background: var(--white); color: var(--muted);
        position: relative; z-index: 2;
        transition: all var(--dur-normal) var(--ease-ios);
    }
    .step.s-done     .step-dot { background: var(--green-bg); border-color: var(--green); color: var(--green); }
    .step.s-active   .step-dot { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 5px rgba(43,90,237,.1); }
    .step.s-rejected .step-dot { background: var(--red-bg); border-color: #fca5a5; color: var(--red-text); }

    .step-label { margin-top: 8px; font-size: 10px; text-align: center; color: var(--muted); max-width: 64px; line-height: 1.4; }
    .step.s-done     .step-label { color: var(--green); font-weight: 600; }
    .step.s-active   .step-label { color: var(--ink); font-weight: 700; }
    .step.s-rejected .step-label { color: var(--red-text); }

    /* Stage cards */
    .stages { display: flex; flex-direction: column; gap: 10px; }
    .stage {
        background: var(--white); border: 1px solid var(--border);
        border-radius: 12px; padding: 18px 20px;
        box-shadow: 0 1px 3px rgba(15,17,23,.04);
        display: flex; gap: 16px;
    }
    .stage.s-done     { border-color: #bbf7d0; }
    .stage.s-current  { border-color: #c7d2fe; background: var(--accent-soft); }
    .stage.s-rejected { border-color: #fecaca; }

    .stage-ico {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; flex-shrink: 0; font-weight: 700;
    }
    .si-done { background: var(--green-bg); color: var(--green); }
    .si-cur  { background: var(--accent-soft); color: var(--accent); }
    .si-wait { background: var(--surface); color: var(--muted); }
    .si-rej  { background: var(--red-bg); color: var(--red-text); }

    .stage-body  { flex: 1; }
    .stage-role  { font-size: 13px; font-weight: 700; margin-bottom: 2px; color: var(--ink); }
    .stage-role.dim { color: var(--muted); font-weight: 400; }
    .stage-who   { font-size: 12px; color: var(--muted); }
    .stage-when  { font-size: 11px; color: var(--muted); margin-top: 3px; }
    .stage-note  { font-size: 12px; color: var(--muted); font-style: italic; margin-top: 5px; }

    /* Approve form */
    .approve-form { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
    .approve-form label {
        font-size: 10px; text-transform: uppercase;
        letter-spacing: .07em; color: var(--muted);
        display: block; margin-bottom: 6px; font-weight: 600;
    }
    .approve-form textarea, .approve-form input, .approve-form select {
        width: 100%; background: var(--white); color: var(--ink);
        border: 1px solid var(--border); border-radius: 10px;
        padding: 9px 12px; font-family: inherit; font-size: 13px;
        resize: vertical; margin-bottom: 12px;
    }
    .approve-form textarea { min-height: 80px; }
    .approve-form textarea:focus, .approve-form input:focus, .approve-form select:focus {
        border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(43,90,237,.12);
    }

    .s2-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 2px; }
    .field-sm { display: flex; flex-direction: column; gap: 5px; }
    .field-sm label { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }

    .action-btns { display: flex; gap: 10px; flex-wrap: wrap; }

    .btn-approve {
        padding: 9px 20px; background: var(--green-bg); border: 1px solid #86efac;
        border-radius: 10px; color: var(--green);
        font-size: 13px; font-weight: 700; cursor: pointer;
        font-family: inherit; transition: all var(--dur-fast) var(--ease-ios);
        display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-approve:hover { background: #bbf7d0; }

    .btn-reject {
        padding: 9px 20px; background: var(--red-bg); border: 1px solid #fca5a5;
        border-radius: 10px; color: var(--red-text);
        font-size: 13px; font-weight: 700; cursor: pointer;
        font-family: inherit; transition: all var(--dur-fast) var(--ease-ios);
        display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-reject:hover { background: #fecaca; }

    .btn-withdraw {
        padding: 7px 16px; background: var(--white);
        border: 1px solid #fca5a5; border-radius: 10px;
        color: var(--red-text); font-size: 12px; font-weight: 600;
        cursor: pointer; font-family: inherit; transition: all var(--dur-fast) var(--ease-ios);
    }
    .btn-withdraw:hover { background: var(--red-bg); }

    /* Notes */
    .track-note {
        display: flex; align-items: flex-start; gap: 10px;
        font-size: 12px; padding: 12px 16px;
        border-radius: 9px; margin-top: 16px; line-height: 1.6;
    }
    .note-cancelled { color: var(--red-text); background: var(--red-bg); border: 1px solid #fca5a5; }
    .note-email { color: var(--muted); background: var(--white); border: 1px solid var(--border); }

    @@media (max-width: 768px) {
        .s2-grid { grid-template-columns: 1fr !important; }
        .track-hero { flex-direction: column; }
        .hero-right { align-items: flex-start; }
        .steps { overflow-x: auto; }
    }
</style>

<div class="wrap">

    <div class="track-topbar">
        <a class="back-link" asp-controller="Outsource" asp-action="Index">← Back to all requests</a>
        <button class="sbtn sm" onclick="window.print()">🖶 Print</button>
    </div>

    <div class="track-hero">
        <div>
            <div class="req-id">OSR-@Model.RequestId.ToString("000000")</div>
            <div class="req-title">@(Model.SapDescription ?? Model.PartNumber)</div>
            <div class="req-meta">
                Part: <strong>@Model.PartNumber</strong>
                &nbsp;·&nbsp; Qty: <strong>@Model.Quantity</strong>
                &nbsp;·&nbsp; Submitted @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                &nbsp;·&nbsp; Waiting @waitingStr
            </div>
        </div>
        <div class="hero-right">
            <span class="rag @ragClass">@badgeLabel</span>
            @if (canWithdraw)
            {
                <form asp-action="Cancel" asp-route-id="@Model.RequestId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-withdraw" id="btn-withdraw">Withdraw Request</button>
                </form>
            }
        </div>
    </div>

    <!-- Step bar -->
    <div class="steps">
        <div class="step s-done">
            <div class="step-dot">✓</div>
            <div class="step-label">Submitted</div>
        </div>
        <div class="step @StepClass(wpDone, wpPending, wpRejectedHere)">
            <div class="step-dot">@(wpRejectedHere ? "✗" : wpDone ? "✓" : wpPending ? "→" : "–")</div>
            <div class="step-label">Work Prep</div>
        </div>
        <div class="step @StepClass(prodDone, prodPending, prodRejectedHere)">
            <div class="step-dot">@(prodRejectedHere ? "✗" : prodDone ? "✓" : prodPending ? "→" : "–")</div>
            <div class="step-label">Production</div>
        </div>
        <div class="step @StepClass(buyerDone, buyerPending, buyerRejectedHere)">
            <div class="step-dot">@(buyerRejectedHere ? "✗" : buyerDone ? "✓" : buyerPending ? "→" : "–")</div>
            <div class="step-label">Cost Compact</div>
        </div>
        <div class="step @StepClass(sourcingDone, sourcingPending, sourcingRejectedHere)">
            <div class="step-dot">@(sourcingRejectedHere ? "✗" : sourcingDone ? "✓" : sourcingPending ? "→" : "–")</div>
            <div class="step-label">Sourcing</div>
        </div>
        <div class="step @StepClass(mdDone && isApproved, mdPending, mdRejectedHere)">
            <div class="step-dot">@(mdRejectedHere ? "✗" : mdDone && isApproved ? "✓" : mdPending ? "→" : "–")</div>
            <div class="step-label">MD Approval</div>
        </div>
        <div class="step @(isApproved ? "s-done" : "")">
            <div class="step-dot">@(isApproved ? "✓" : "–")</div>
            <div class="step-label">Complete</div>
        </div>
    </div>

    <!-- Stage detail cards -->
    <div class="stages">

        <!-- Submitted -->
        <div class="stage s-done">
            <div class="stage-ico si-done">✓</div>
            <div class="stage-body">
                <div class="stage-role">Request submitted</div>
                <div class="stage-who">@Model.CreatedByUsername</div>
                <div class="stage-when">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
        </div>

        <!-- Stage 1: Work Preparation (John Fisher) -->
        <div class="stage @(wpRejectedHere ? "s-rejected" : wpDone ? "s-done" : wpPending ? "s-current" : "")">
            <div class="stage-ico @(wpRejectedHere ? "si-rej" : wpDone ? "si-done" : wpPending ? "si-cur" : "si-wait")">
                @(wpRejectedHere ? "✗" : wpDone ? "✓" : wpPending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!wpDone && !wpPending ? "dim" : "")">
                    Work Preparation
                    @if (wp != null && (wpDone || wpPending))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @wp.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (wpPending && wp != null) { <text>Awaiting sign-off from @wp.FullName</text> }
                    else if (wpDone)             { <text>Signed by @Model.JFSignedBy</text> }
                    else                          { <text>Not yet reached</text> }
                </div>
                @if (wpDone)
                {
                    <div class="stage-when">@Model.JFSignedDate?.ToString("dd MMM yyyy, HH:mm")</div>
                }

                @if (wpPending && isWpApprover)
                {
                    <div class="approve-form">
                        <form asp-action="ReviewWorkPrep" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <label>Comments (optional)</label>
                            <textarea name="comments" placeholder="Any notes for the requester or next reviewer…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — pass to Production</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Stage 2: Production (Lukasz Jaworski) -->
        <div class="stage @(prodRejectedHere ? "s-rejected" : prodDone ? "s-done" : prodPending ? "s-current" : "")">
            <div class="stage-ico @(prodRejectedHere ? "si-rej" : prodDone ? "si-done" : prodPending ? "si-cur" : "si-wait")">
                @(prodRejectedHere ? "✗" : prodDone ? "✓" : prodPending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!prodDone && !prodPending ? "dim" : "")">
                    Production
                    @if (prod != null && (prodDone || prodPending))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @prod.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (prodPending && prod != null) { <text>Awaiting sign-off from @prod.FullName</text> }
                    else if (prodDone)                { <text>Signed by @Model.LJSignedBy</text> }
                    else                               { <text>Not yet reached</text> }
                </div>
                @if (prodDone)
                {
                    <div class="stage-when">@Model.LJSignedDate?.ToString("dd MMM yyyy, HH:mm")</div>
                }

                @if (prodPending && isProdApprover)
                {
                    <div class="approve-form">
                        <form asp-action="ReviewProduction" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <label>Comments (optional)</label>
                            <textarea name="comments" placeholder="Any notes for the requester or next reviewer…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — pass to Cost Compact</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Stage 3: Cost Compact (Chris Welland, Strategic Buyer) -->
        <div class="stage @(buyerRejectedHere ? "s-rejected" : buyerDone ? "s-done" : buyerPending ? "s-current" : "")">
            <div class="stage-ico @(buyerRejectedHere ? "si-rej" : buyerDone ? "si-done" : buyerPending ? "si-cur" : "si-wait")">
                @(buyerRejectedHere ? "✗" : buyerDone ? "✓" : buyerPending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!buyerDone && !buyerPending ? "dim" : "")">
                    Cost Compact — Strategic Buyer
                    @if (buyer != null && (buyerDone || buyerPending))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @buyer.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (buyerPending && buyer != null) { <text>Awaiting PPAP decision and cost impact from @buyer.FullName</text> }
                    else if (buyerDone)                 { <text>Reviewed by @Model.ScReviewedBy</text> }
                    else                                 { <text>Not yet reached</text> }
                </div>
                @if (buyerDone)
                {
                    <div class="stage-when">@Model.ScReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.ScComments))
                    {
                        <div class="stage-note">"@Model.ScComments"</div>
                    }
                }

                @if (buyerPending && isBuyerApprover)
                {
                    <div class="approve-form">
                        <form asp-action="ReviewCostCompact" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <div class="s2-grid">
                                <div class="field-sm">
                                    <label>PPAP required?</label>
                                    <select name="ppapRequired">
                                        <option value="false">No</option>
                                        <option value="true">Yes</option>
                                    </select>
                                </div>
                                <div class="field-sm">
                                    <label>Cost impact note</label>
                                    <input name="costComments" placeholder="Optional" />
                                </div>
                                <div class="field-sm">
                                    <label>In-house cost / month (£)</label>
                                    <input name="costInhouse" type="number" step="0.01" placeholder="0.00" />
                                </div>
                                <div class="field-sm">
                                    <label>Outsource cost / month (£)</label>
                                    <input name="costOutsource" type="number" step="0.01" placeholder="0.00" />
                                </div>
                            </div>
                            <label>Comments for Sourcing (optional)</label>
                            <textarea name="scComments" placeholder="Any comments to pass to Sourcing…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — pass to Sourcing</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Stage 4: Sourcing (Simon Graham) -->
        <div class="stage @(sourcingRejectedHere ? "s-rejected" : sourcingDone ? "s-done" : sourcingPending ? "s-current" : "")">
            <div class="stage-ico @(sourcingRejectedHere ? "si-rej" : sourcingDone ? "si-done" : sourcingPending ? "si-cur" : "si-wait")">
                @(sourcingRejectedHere ? "✗" : sourcingDone ? "✓" : sourcingPending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!sourcingDone && !sourcingPending ? "dim" : "")">
                    Sourcing &amp; Procurement
                    @if (sourcing != null && (sourcingDone || sourcingPending))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @sourcing.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (sourcingPending && sourcing != null) { <text>Awaiting sign-off from @sourcing.FullName</text> }
                    else if (sourcingDone)                    { <text>Signed by @Model.SGSignedBy</text> }
                    else                                        { <text>Not yet reached</text> }
                </div>
                @if (sourcingDone)
                {
                    <div class="stage-when">@Model.SGSignedDate?.ToString("dd MMM yyyy, HH:mm")</div>
                }

                @if (sourcingPending && isSourcingApprover)
                {
                    <div class="approve-form">
                        <form asp-action="ReviewSourcing" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <label>Comments (optional)</label>
                            <textarea name="comments" placeholder="Any notes for the requester or the MD…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — pass to MD</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Stage 5: Managing Director (Patrick MacDonough) -->
        <div class="stage @(mdRejectedHere ? "s-rejected" : mdDone && isApproved ? "s-done" : mdPending ? "s-current" : "")">
            <div class="stage-ico @(mdRejectedHere ? "si-rej" : mdDone && isApproved ? "si-done" : mdPending ? "si-cur" : "si-wait")">
                @(mdRejectedHere ? "✗" : mdDone && isApproved ? "✓" : mdPending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!mdDone && !mdPending ? "dim" : "")">
                    Managing Director approval
                    @if (md != null && (mdDone || mdPending))
                    {
                        <span style="font-weight:400;color:var(--muted)"> — @md.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (mdPending && md != null) { <text>Awaiting final approval from @md.FullName</text> }
                    else if (mdDone && isApproved) { <text>Approved by @Model.MdReviewedBy — outsourcing authorised</text> }
                    else if (mdDone && isRejected) { <text>Rejected by @Model.MdReviewedBy</text> }
                    else                             { <text>Not yet reached</text> }
                </div>
                @if (mdDone)
                {
                    <div class="stage-when">@Model.MdReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.MdComments))
                    {
                        <div class="stage-note">"@Model.MdComments"</div>
                    }
                }

                @if (mdPending && isMdApprover)
                {
                    <div class="approve-form">
                        <form asp-action="ApproveMD" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <label>Final decision comments (optional)</label>
                            <textarea name="mdComments" placeholder="Final decision notes…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — authorise outsourcing</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

    </div>

    @if (isCancelled)
    {
        <div class="track-note note-cancelled">
            <span style="font-size:16px">✕</span>
            <span>This request was withdrawn. @(!string.IsNullOrEmpty(Model.RejectionReason) ? Model.RejectionReason : "")</span>
        </div>
    }
    else if (isRejected)
    {
        <div class="track-note note-cancelled">
            <span style="font-size:16px">✕</span>
            <span>
                This request was rejected by @Model.RejectedBy on @(Model.RejectedAt?.ToString("dd MMM yyyy, HH:mm")).
                @(!string.IsNullOrEmpty(Model.RejectionReason) ? $"\"{Model.RejectionReason}\"" : "")
            </span>
        </div>
    }
    else
    {
        <div class="track-note note-email">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>
                Email notifications are sent automatically at each stage.
                @if (Model.LastReminderSentAt.HasValue)
                {
                    <text> Last reminder: @Model.LastReminderSentAt.Value.ToString("dd MMM yyyy, HH:mm").</text>
                }
            </span>
        </div>
    }

</div>

@section Scripts {
    <script>
        // Themed confirm dialogs for approve / reject
        document.querySelectorAll('.btn-approve, .btn-reject').forEach(btn => {
            btn.addEventListener('click', async function (e) {
                e.preventDefault();
                const isApprove = this.classList.contains('btn-approve');
                const msg = isApprove
                    ? 'Approve this request and pass it to the next stage?'
                    : 'Reject this request? This action cannot be undone.';
                const ok = await SiteModal.confirm(msg, isApprove ? 'Approve Request' : 'Reject Request');
                if (ok) {
                    const form = this.closest('form');
                    // Programmatic form.submit() does NOT include the clicked button's
                    // name/value, so inject the action explicitly before submitting —
                    // otherwise the server receives a null action and treats every
                    // decision as a rejection.
                    let actionField = form.querySelector('input[name="action"]');
                    if (!actionField) {
                        actionField = document.createElement('input');
                        actionField.type = 'hidden';
                        actionField.name = 'action';
                        form.appendChild(actionField);
                    }
                    actionField.value = this.value;
                    form.submit();
                }
            });
        });

        // Withdraw confirmation
        const withdrawBtn = document.getElementById('btn-withdraw');
        if (withdrawBtn) {
            withdrawBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const ok = await SiteModal.confirm(
                    'This will withdraw the request and notify the team. This cannot be undone.',
                    'Withdraw Request'
                );
                if (ok) this.closest('form').submit();
            });
        }

        // Scroll to active stage
        const activeStage = document.querySelector('.stage.s-current');
        if (activeStage) {
            setTimeout(() => activeStage.scrollIntoView({ behavior: 'smooth', block: 'center' }), 350);
        }
    </script>
}
