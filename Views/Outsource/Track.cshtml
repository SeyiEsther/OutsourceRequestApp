@model OutsourceRequestApp.Models.OutsourceRequest
@using OutsourceRequestApp.Models

@{
    ViewData["Title"] = $"Track OSR-{Model.RequestId:000000}";
    var roles = ViewBag.Roles as List<ApproverRole> ?? new List<ApproverRole>();
    var currentUser = ViewBag.CurrentUsername as string ?? "";

    var sc      = roles.FirstOrDefault(r => r.RoleKey == "SC");
    var finance = roles.FirstOrDefault(r => r.RoleKey == "Finance");
    var md      = roles.FirstOrDefault(r => r.RoleKey == "MD");

    bool scDone      = Model.ScReviewedAt.HasValue;
    bool financeDone = Model.FinanceReviewedAt.HasValue;
    bool mdDone      = Model.MdReviewedAt.HasValue;

    bool scPending      = Model.Status == "Submitted";
    bool financePending = Model.Status == "Finance_Pending";
    bool mdPending      = Model.Status == "MD_Pending";

    bool isScApprover      = sc      != null && sc.Username.Equals(currentUser, StringComparison.OrdinalIgnoreCase);
    bool isFinanceApprover = finance != null && finance.Username.Equals(currentUser, StringComparison.OrdinalIgnoreCase);
    bool isMdApprover      = md      != null && md.Username.Equals(currentUser, StringComparison.OrdinalIgnoreCase);

    string badgeClass = RequestStatus.BadgeClass(Model.Status);
    string badgeLabel = RequestStatus.Label(Model.Status);
    bool isCancelled  = Model.Status == RequestStatus.Cancelled;
    bool canWithdraw  = Model.Status == RequestStatus.Submitted &&
                        currentUser.Equals(Model.CreatedByUsername, StringComparison.OrdinalIgnoreCase);

    var waiting = DateTime.Now - Model.CreatedAt;
    string waitingStr = waiting.TotalDays >= 1
        ? $"{(int)waiting.TotalDays}d {waiting.Hours}h"
        : $"{waiting.Hours}h {waiting.Minutes}m";
}

<style>
    .track-pg { max-width: 860px; margin: 0 auto; padding: 36px 24px 60px; }

    /* Top bar */
    .track-topbar {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 28px; flex-wrap: wrap; gap: 10px;
    }

    /* Hero */
    .track-hero {
        background: var(--card); border: 1px solid var(--border);
        border-radius: 14px; padding: 24px 26px;
        margin-bottom: 24px;
        display: flex; justify-content: space-between; align-items: flex-start;
        gap: 20px; flex-wrap: wrap;
    }
    .req-id    { font-family: var(--mono); font-size: 11px; color: var(--text3); margin-bottom: 5px; }
    .req-title { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; }
    .req-meta  { font-size: 12px; color: var(--text2); margin-top: 6px; line-height: 1.7; }

    .hero-right { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }

    /* Step bar */
    .steps {
        display: flex; align-items: flex-start;
        margin-bottom: 28px; position: relative;
    }
    .step {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; position: relative; z-index: 1;
    }
    .step:not(:last-child)::after {
        content: ''; position: absolute;
        top: 19px; left: 50%; right: -50%;
        height: 2px; background: var(--border2); z-index: 0;
    }
    .step:not(:last-child).s-done::after { background: var(--green); }

    .step-dot {
        width: 38px; height: 38px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; font-weight: 600;
        border: 2px solid var(--border2);
        background: var(--card2); color: var(--text3);
        position: relative; z-index: 2;
        transition: all .25s;
    }
    .step.s-done   .step-dot { background: rgba(34,197,94,.12); border-color: var(--green); color: var(--green); }
    .step.s-active .step-dot { background: var(--accent-dim);   border-color: var(--accent); color: var(--accent); box-shadow: 0 0 0 5px rgba(230,57,70,.1); }

    .step-label { margin-top: 8px; font-size: 11px; text-align: center; color: var(--text3); max-width: 70px; line-height: 1.4; }
    .step.s-done   .step-label { color: var(--green); }
    .step.s-active .step-label { color: var(--text); font-weight: 600; }

    /* Stage cards */
    .stages { display: flex; flex-direction: column; gap: 10px; }

    .stage {
        background: var(--card); border: 1px solid var(--border);
        border-radius: 12px; padding: 18px 20px;
        display: flex; gap: 16px;
    }
    .stage.s-done     { border-color: rgba(34,197,94,.2); }
    .stage.s-current  { border-color: rgba(230,57,70,.25); background: rgba(230,57,70,.02); }
    .stage.s-rejected { border-color: rgba(239,68,68,.25); }

    .stage-ico {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; flex-shrink: 0; font-weight: 600;
    }
    .si-done { background: rgba(34,197,94,.1);  color: var(--green); }
    .si-cur  { background: var(--accent-dim);   color: var(--accent); }
    .si-wait { background: var(--card2);         color: var(--text3); }
    .si-rej  { background: rgba(239,68,68,.1);  color: #f87171; }

    .stage-body  { flex: 1; }
    .stage-role  { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
    .stage-role.dim { color: var(--text2); font-weight: 400; }
    .stage-who   { font-size: 12px; color: var(--text2); }
    .stage-when  { font-size: 11px; color: var(--text3); font-family: var(--mono); margin-top: 3px; }
    .stage-note  { font-size: 12px; color: var(--text2); font-style: italic; margin-top: 5px; }

    /* Approve form */
    .approve-form {
        margin-top: 16px; padding-top: 16px;
        border-top: 1px solid var(--border);
    }
    .approve-form label {
        font-size: 10px; text-transform: uppercase;
        letter-spacing: .07em; color: var(--text2);
        display: block; margin-bottom: 6px; font-weight: 600;
    }
    .approve-form textarea,
    .approve-form input,
    .approve-form select {
        width: 100%;
        background: var(--bg); color: var(--text);
        border: 1px solid var(--border2); border-radius: 8px;
        padding: 9px 12px; font-family: var(--font); font-size: 13px;
        resize: vertical; margin-bottom: 12px;
    }
    .approve-form textarea { min-height: 80px; }
    .approve-form textarea:focus,
    .approve-form input:focus,
    .approve-form select:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px var(--accent-dim); }

    .s2-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 2px; }
    .field-sm { display: flex; flex-direction: column; gap: 5px; }
    .field-sm label { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: var(--text2); font-weight: 600; }

    .action-btns { display: flex; gap: 10px; flex-wrap: wrap; }

    .btn-approve {
        padding: 9px 20px; background: rgba(34,197,94,.1);
        border: 1px solid rgba(34,197,94,.3);
        border-radius: 8px; color: var(--green);
        font-size: 13px; font-weight: 600; cursor: pointer;
        font-family: var(--font); transition: all .15s;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-approve:hover { background: rgba(34,197,94,.18); }

    .btn-reject {
        padding: 9px 20px; background: rgba(239,68,68,.07);
        border: 1px solid rgba(239,68,68,.22);
        border-radius: 8px; color: #f87171;
        font-size: 13px; font-weight: 600; cursor: pointer;
        font-family: var(--font); transition: all .15s;
        display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-reject:hover { background: rgba(239,68,68,.14); }

    /* Withdraw button */
    .btn-withdraw {
        padding: 7px 16px; background: transparent;
        border: 1px solid rgba(239,68,68,.3); border-radius: 8px;
        color: #f87171; font-size: 12px; font-weight: 500;
        cursor: pointer; font-family: var(--font); transition: all .15s;
    }
    .btn-withdraw:hover { background: rgba(239,68,68,.1); border-color: rgba(239,68,68,.5); }

    /* Notes */
    .track-note {
        display: flex; align-items: flex-start; gap: 10px;
        font-size: 12px; padding: 12px 16px;
        border-radius: 9px; margin-top: 16px; line-height: 1.6;
    }
    .note-cancelled {
        color: #f87171; background: rgba(239,68,68,.07);
        border: 1px solid rgba(239,68,68,.2);
    }
    .note-email {
        color: var(--text2); background: var(--card);
        border: 1px solid var(--border);
    }

    @@media (max-width: 768px) {
        .s2-grid { grid-template-columns: 1fr !important; }
        .track-hero { flex-direction: column; }
        .hero-right { align-items: flex-start; }
    }
</style>

<div class="track-pg">

    <div class="track-topbar">
        <a class="back-link" asp-controller="Outsource" asp-action="Index">
            ← Back to all requests
        </a>
        <button class="btn-ghost" style="font-size:12px;padding:7px 14px;" onclick="window.print()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 6 2 18 2 18 9"/>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
            </svg>
            Print
        </button>
    </div>

    <div class="track-hero">
        <div>
            <div class="req-id">OSR-@Model.RequestId.ToString("000000")</div>
            <div class="req-title">@(Model.SapDescription ?? Model.PartNumber)</div>
            <div class="req-meta">
                Part: <strong>@Model.PartNumber</strong>
                &nbsp;·&nbsp; Qty: <strong>@Model.Quantity</strong>
                &nbsp;·&nbsp; Submitted @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                &nbsp;·&nbsp; Waiting @waitingStr
            </div>
        </div>
        <div class="hero-right">
            <span class="badge @badgeClass">@badgeLabel</span>
            @if (canWithdraw)
            {
                <form asp-action="Cancel" asp-route-id="@Model.RequestId" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-withdraw" id="btn-withdraw">Withdraw Request</button>
                </form>
            }
        </div>
    </div>

    <!-- Step bar -->
    <div class="steps">
        <div class="step s-done">
            <div class="step-dot">✓</div>
            <div class="step-label">Submitted</div>
        </div>
        <div class="step @(scDone && !isCancelled ? "s-done" : scPending ? "s-active" : "")">
            <div class="step-dot">@(scDone && !isCancelled ? "✓" : isCancelled ? "✗" : scPending ? "→" : "–")</div>
            <div class="step-label">Supply Chain</div>
        </div>
        <div class="step @(financeDone ? "s-done" : financePending ? "s-active" : "")">
            <div class="step-dot">@(financeDone ? "✓" : financePending ? "→" : "–")</div>
            <div class="step-label">Finance</div>
        </div>
        <div class="step @(mdDone && Model.Status == "Approved" ? "s-done" : mdPending ? "s-active" : "")">
            <div class="step-dot">@(mdDone && Model.Status == "Approved" ? "✓" : mdPending ? "→" : "–")</div>
            <div class="step-label">MD Approval</div>
        </div>
        <div class="step @(Model.Status == "Approved" ? "s-done" : "")">
            <div class="step-dot">@(Model.Status == "Approved" ? "✓" : "–")</div>
            <div class="step-label">Complete</div>
        </div>
    </div>

    <!-- Stage detail cards -->
    <div class="stages">

        <!-- Submitted -->
        <div class="stage s-done">
            <div class="stage-ico si-done">✓</div>
            <div class="stage-body">
                <div class="stage-role">Work Preparation — submitted</div>
                <div class="stage-who">@Model.CreatedByUsername</div>
                <div class="stage-when">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
        </div>

        <!-- Supply Chain -->
        <div class="stage @(scDone ? "s-done" : scPending ? "s-current" : Model.Status == "Rejected" && !scDone ? "s-rejected" : "")">
            <div class="stage-ico @(scDone ? "si-done" : scPending ? "si-cur" : "si-wait")">
                @(scDone ? "✓" : scPending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!scDone && !scPending ? "dim" : "")">
                    Supply Chain Review
                    @if (sc != null && (scDone || scPending))
                    {
                        <span style="font-weight:400;color:var(--text2)"> — @sc.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (scPending && sc != null) { <text>Awaiting PPAP decision and cost impact from @sc.FullName</text> }
                    else if (scDone)              { <text>Reviewed by @Model.ScReviewedBy</text> }
                    else                         { <text>Not yet reached</text> }
                </div>
                @if (scDone)
                {
                    <div class="stage-when">@Model.ScReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.ScComments))
                    {
                        <div class="stage-note">"@Model.ScComments"</div>
                    }
                }

                @if (scPending && isScApprover)
                {
                    <div class="approve-form">
                        <form asp-action="Review" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <div class="s2-grid">
                                <div class="field-sm">
                                    <label>PPAP required?</label>
                                    <select name="ppapRequired">
                                        <option value="false">No</option>
                                        <option value="true">Yes</option>
                                    </select>
                                </div>
                                <div class="field-sm">
                                    <label>Cost impact note</label>
                                    <input name="costComments" placeholder="Optional" />
                                </div>
                                <div class="field-sm">
                                    <label>In-house cost / month (£)</label>
                                    <input name="costInhouse" type="number" step="0.01" placeholder="0.00" />
                                </div>
                                <div class="field-sm">
                                    <label>Outsource cost / month (£)</label>
                                    <input name="costOutsource" type="number" step="0.01" placeholder="0.00" />
                                </div>
                            </div>
                            <label>Comments for Finance (optional)</label>
                            <textarea name="scComments" placeholder="Any comments to pass to Finance…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — pass to Finance</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Finance -->
        <div class="stage @(financeDone ? "s-done" : financePending ? "s-current" : "")">
            <div class="stage-ico @(financeDone ? "si-done" : financePending ? "si-cur" : "si-wait")">
                @(financeDone ? "✓" : financePending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!financeDone && !financePending ? "dim" : "")">
                    Finance Director sign-off
                    @if (finance != null && (financeDone || financePending))
                    {
                        <span style="font-weight:400;color:var(--text2)"> — @finance.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (financePending && finance != null) { <text>Awaiting sign-off from @finance.FullName</text> }
                    else if (financeDone)                   { <text>Reviewed by @Model.FinanceReviewedBy</text> }
                    else                                    { <text>Not yet reached</text> }
                </div>
                @if (financeDone)
                {
                    <div class="stage-when">@Model.FinanceReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.FinanceComments))
                    {
                        <div class="stage-note">"@Model.FinanceComments"</div>
                    }
                }

                @if (financePending && isFinanceApprover)
                {
                    <div class="approve-form">
                        <form asp-action="ApproveFinance" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <label>Comments for MD (optional)</label>
                            <textarea name="financeComments" placeholder="Any comments to pass to the MD…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — pass to MD</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Managing Director -->
        <div class="stage @(mdDone && Model.Status == "Approved" ? "s-done" : mdDone && Model.Status == "Rejected" ? "s-rejected" : mdPending ? "s-current" : "")">
            <div class="stage-ico @(mdDone && Model.Status == "Approved" ? "si-done" : mdDone && Model.Status == "Rejected" ? "si-rej" : mdPending ? "si-cur" : "si-wait")">
                @(mdDone && Model.Status == "Approved" ? "✓" : mdDone && Model.Status == "Rejected" ? "✗" : mdPending ? "→" : "–")
            </div>
            <div class="stage-body">
                <div class="stage-role @(!mdDone && !mdPending ? "dim" : "")">
                    Managing Director approval
                    @if (md != null && (mdDone || mdPending))
                    {
                        <span style="font-weight:400;color:var(--text2)"> — @md.FullName</span>
                    }
                </div>
                <div class="stage-who">
                    @if (mdPending && md != null)                    { <text>Awaiting final approval from @md.FullName</text> }
                    else if (mdDone && Model.Status == "Approved")   { <text>Approved by @Model.MdReviewedBy — outsourcing authorised</text> }
                    else if (mdDone && Model.Status == "Rejected")   { <text>Rejected by @Model.MdReviewedBy</text> }
                    else                                              { <text>Not yet reached</text> }
                </div>
                @if (mdDone)
                {
                    <div class="stage-when">@Model.MdReviewedAt?.ToString("dd MMM yyyy, HH:mm")</div>
                    @if (!string.IsNullOrEmpty(Model.MdComments))
                    {
                        <div class="stage-note">"@Model.MdComments"</div>
                    }
                }

                @if (mdPending && isMdApprover)
                {
                    <div class="approve-form">
                        <form asp-action="ApproveMD" asp-route-id="@Model.RequestId" method="post">
                            @Html.AntiForgeryToken()
                            <label>Final decision comments (optional)</label>
                            <textarea name="mdComments" placeholder="Final decision notes…"></textarea>
                            <div class="action-btns">
                                <button type="submit" name="action" value="approve" class="btn-approve">✓ Approve — authorise outsourcing</button>
                                <button type="submit" name="action" value="reject"  class="btn-reject">✗ Reject</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

    </div>

    @if (isCancelled)
    {
        <div class="track-note note-cancelled">
            <span style="font-size:16px">✕</span>
            <span>This request was withdrawn. @(!string.IsNullOrEmpty(Model.ScComments) ? Model.ScComments : "")</span>
        </div>
    }
    else
    {
        <div class="track-note note-email">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>
                Email notifications are sent automatically at each stage.
                @if (Model.LastReminderSentAt.HasValue)
                {
                    <text> Last reminder: @Model.LastReminderSentAt.Value.ToString("dd MMM yyyy, HH:mm").</text>
                }
            </span>
        </div>
    }

</div>

@section Scripts {
    <script>
        // Themed confirm dialogs for approve / reject
        document.querySelectorAll('.btn-approve, .btn-reject').forEach(btn => {
            btn.addEventListener('click', async function (e) {
                e.preventDefault();
                const isApprove = this.classList.contains('btn-approve');
                const msg = isApprove
                    ? 'Approve this request and pass it to the next stage?'
                    : 'Reject this request? This action cannot be undone.';
                const ok = await SiteModal.confirm(msg, isApprove ? 'Approve Request' : 'Reject Request');
                if (ok) this.closest('form').submit();
            });
        });

        // Withdraw confirmation
        const withdrawBtn = document.getElementById('btn-withdraw');
        if (withdrawBtn) {
            withdrawBtn.addEventListener('click', async function (e) {
                e.preventDefault();
                const ok = await SiteModal.confirm(
                    'This will withdraw the request and notify the team. This cannot be undone.',
                    'Withdraw Request'
                );
                if (ok) this.closest('form').submit();
            });
        }

        // Scroll to active stage
        const activeStage = document.querySelector('.stage.s-current');
        if (activeStage) {
            setTimeout(() => activeStage.scrollIntoView({ behavior: 'smooth', block: 'center' }), 350);
        }
    </script>
}
