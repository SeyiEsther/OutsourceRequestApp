@using OutsourceRequestApp.Models
@inject OutsourceRequestApp.Services.ActiveDirectoryLookup Ad

@{
    ViewData["Title"] = "My Approvals";
    var myRole = ViewBag.MyRole as ApproverRole;
    var pending  = ViewBag.Pending as List<OutsourceRequest> ?? new List<OutsourceRequest>();
    int approved = (int)(ViewBag.Approved ?? 0);
    int rejected = (int)(ViewBag.Rejected ?? 0);
}

<style>
    /* Profile hero */
    .role-hero {
        display: flex; align-items: center; gap: 18px;
        background: var(--white); border: 1px solid var(--border);
        border-radius: 14px; padding: 22px 24px;
        margin-bottom: 20px; box-shadow: 0 1px 3px rgba(15,17,23,.04);
    }
    .role-avatar {
        width: 52px; height: 52px; border-radius: 50%;
        background: var(--accent-soft);
        border: 2px solid #c7d2fe;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; font-weight: 700; color: var(--accent); flex-shrink: 0;
    }
    .role-name { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
    .role-sub  { font-size: 13px; color: var(--muted); margin-top: 3px; }

    /* Queue */
    .queue-head {
        font-size: 10px; text-transform: uppercase; letter-spacing: .1em;
        color: var(--muted); font-weight: 700; margin-bottom: 12px;
    }
    .queue { display: flex; flex-direction: column; gap: 10px; }

    .queue-item {
        background: var(--white);
        border: 1px solid #c7d2fe;
        border-radius: 12px; padding: 18px 20px;
        display: flex; justify-content: space-between;
        align-items: center; gap: 16px;
        box-shadow: 0 1px 3px rgba(15,17,23,.04);
        transition: box-shadow var(--dur-normal) var(--ease-ios);
    }
    .queue-item:hover { box-shadow: 0 8px 28px rgba(15,17,23,.07); }

    .qi-id   { font-size: 11px; color: var(--muted); margin-bottom: 4px; font-weight: 600; }
    .qi-part { font-size: 14px; font-weight: 700; letter-spacing: -0.01em; }
    .qi-meta { font-size: 12px; color: var(--muted); margin-top: 3px; }
    .qi-age  { font-size: 11px; font-weight: 600; margin-top: 6px; }
    .age-ok   { color: var(--muted); }
    .age-warn { color: var(--amber-text); }
    .age-over { color: var(--red-text); }

    /* Empty / no role */
    .empty-card {
        background: var(--white); border: 1px solid var(--border);
        border-radius: 14px; padding: 48px 32px;
        text-align: center; color: var(--muted);
    }
    .empty-card p { margin-bottom: 6px; }
    .empty-card p:first-child { font-size: 16px; font-weight: 700; color: var(--ink); }

    .all-clear {
        background: var(--green-bg); border: 1px solid #86efac;
        border-radius: 12px; padding: 32px;
        text-align: center;
    }
    .all-clear-ico {
        width: 44px; height: 44px; border-radius: 50%;
        background: #bbf7d0;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 12px; font-size: 18px; color: var(--green);
    }
    .all-clear p { font-size: 14px; color: var(--green); font-weight: 600; }

    @@media (max-width: 768px) {
        .queue-item { flex-direction: column; align-items: flex-start; }
        .role-hero  { flex-direction: column; text-align: center; }
    }
</style>

<div class="wrap">

    @if (myRole == null)
    {
        <div class="empty-card">
            <p>You are not assigned to an approval role.</p>
            <p style="font-size:13px;margin-top:8px;">Contact an admin to be assigned as a Work Preparation, Production, Strategic Buyer, Sourcing, or MD approver.</p>
        </div>
    }
    else
    {
        var initials = string.Join("", myRole.FullName.Split(' ').Take(2).Select(w => w[0]));

        <div class="role-hero">
            <div class="role-avatar">@initials</div>
            <div>
                <div class="role-name">@myRole.FullName</div>
                <div class="role-sub">@myRole.RoleDisplayName · <span style="font-size:11px">@myRole.Email</span></div>
            </div>
        </div>

        <div class="kpi-row" style="grid-template-columns:repeat(3,1fr);">
            <div class="kpi"><div class="kpi-label">Awaiting your action</div><div class="kpi-val amber">@pending.Count</div></div>
            <div class="kpi"><div class="kpi-label">Approved by you</div><div class="kpi-val green">@approved</div></div>
            <div class="kpi"><div class="kpi-label">Rejected</div><div class="kpi-val red">@rejected</div></div>
        </div>

        @if (!pending.Any())
        {
            <div class="all-clear">
                <div class="all-clear-ico">✓</div>
                <p>All caught up — nothing awaiting your approval.</p>
            </div>
        }
        else
        {
            <div class="queue-head">Waiting for your approval (@pending.Count)</div>
            <div class="queue">
                @foreach (var r in pending)
                {
                    var waiting = DateTime.Now - r.CreatedAt;
                    string waitStr = waiting.TotalDays >= 1
                        ? $"{(int)waiting.TotalDays}d {waiting.Hours}h"
                        : $"{waiting.Hours}h {waiting.Minutes}m";
                    string ageClass  = waiting.TotalDays >= 3 ? "age-over" : waiting.TotalDays >= 1 ? "age-warn" : "age-ok";
                    string agePrefix = waiting.TotalDays >= 3 ? "⚠ Overdue — " : "Waiting ";

                    <div class="queue-item">
                        <div>
                            <div class="qi-id">OSR-@r.RequestId.ToString("000000")</div>
                            <div class="qi-part">@(r.SapDescription ?? r.PartNumber)</div>
                            <div class="qi-meta">Part: @r.PartNumber · Qty: @r.Quantity · by @Ad.DisplayNameOrRaw(r.CreatedByUsername)</div>
                            <div class="qi-age @ageClass">@agePrefix@waitStr</div>
                        </div>
                        <a class="sbtn primary"
                           asp-controller="Outsource" asp-action="Track" asp-route-id="@r.RequestId">
                            Review →
                        </a>
                    </div>
                }
            </div>
        }
    }

</div>
