@using OutsourceRequestApp.Models

@{
    ViewData["Title"] = "My Approvals";
    var myRole = ViewBag.MyRole as ApproverRole;
    var pending = ViewBag.Pending as List<OutsourceRequest> ?? new List<OutsourceRequest>();
    int approved = (int)(ViewBag.Approved ?? 0);
    int rejected = (int)(ViewBag.Rejected ?? 0);
}

<style>
    .profile-wrap {
        max-width: 860px;
        margin: 0 auto;
        padding: 40px 24px 60px;
    }

    .profile-hero {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 32px;
    }

    .profile-avatar {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: rgba(227,6,19,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 600;
        color: var(--red);
        flex-shrink: 0;
    }

    .profile-name {
        font-size: 20px;
        font-weight: 500;
    }

    .profile-sub {
        font-size: 13px;
        color: var(--muted);
        margin-top: 3px;
    }

    .stat-pills {
        display: flex;
        gap: 12px;
        margin-bottom: 32px;
    }

    .sp {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px 20px;
        flex: 1;
        text-align: center;
    }

    .sp-val {
        font-size: 26px;
        font-weight: 400;
        font-family: var(--mono);
    }

    .sp-label {
        font-size: 11px;
        color: var(--muted);
        margin-top: 5px;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .queue-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--muted);
        margin-bottom: 12px;
        font-weight: 500;
    }

    .queue {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .queue-item {
        background: var(--surface);
        border: 1px solid rgba(227,6,19,.2);
        border-radius: 10px;
        padding: 18px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
    }

    .qi-id {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--muted);
        margin-bottom: 4px;
    }

    .qi-part {
        font-size: 13px;
        font-weight: 500;
    }

    .qi-meta {
        font-size: 12px;
        color: var(--muted);
        margin-top: 3px;
    }

    .qi-age {
        font-size: 11px;
        margin-top: 5px;
    }

    .age-warn {
        color: #fbbf24;
    }

    .age-over {
        color: #f87171;
    }

    .btn-review {
        padding: 8px 20px;
        background: var(--red);
        border: none;
        border-radius: 7px;
        color: #fff;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        white-space: nowrap;
        font-family: var(--font);
    }

        .btn-review:hover {
            background: var(--red-dark);
            color: #fff;
        }

    .no-role {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        color: var(--muted);
    }

    .empty {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 40px;
        text-align: center;
        color: var(--muted);
    }
</style>

<div class="profile-wrap">

    @if (myRole == null)
    {
        <div class="no-role">
            <p style="font-size:15px;margin-bottom:8px;">You are not assigned to an approval role.</p>
            <p style="font-size:13px;">Contact an admin to be assigned as Supply Chain, Finance, or MD approver.</p>
        </div>
    }
    else
    {
        var initials = string.Join("", myRole.FullName.Split(' ').Take(2).Select(w => w[0]));

        <div class="profile-hero">
            <div class="profile-avatar">@initials</div>
            <div>
                <div class="profile-name">@myRole.FullName</div>
                <div class="profile-sub">@myRole.RoleDisplayName · @myRole.Username</div>
            </div>
        </div>

        <div class="stat-pills">
            <div class="sp">
                <div class="sp-val" style="color:#fbbf24">@pending.Count</div>
                <div class="sp-label">Awaiting your action</div>
            </div>
            <div class="sp">
                <div class="sp-val" style="color:#4ade80">@approved</div>
                <div class="sp-label">Approved by you</div>
            </div>
            <div class="sp">
                <div class="sp-val" style="color:#f87171">@rejected</div>
                <div class="sp-label">Rejected</div>
            </div>
        </div>

        <div class="queue-label">Waiting for your approval</div>

        @if (!pending.Any())
        {
            <div class="empty">
                <p>Nothing waiting for your approval right now.</p>
            </div>
        }
        else
        {
            <div class="queue">
                @foreach (var r in pending)
                {
                    var waiting = DateTime.Now - r.CreatedAt;
                    string waitStr = waiting.TotalDays >= 1
                    ? $"{(int)waiting.TotalDays}d {waiting.Hours}h"
                    : $"{waiting.Hours}h {waiting.Minutes}m";
                    string ageClass = waiting.TotalDays >= 3 ? "age-over"
                    : waiting.TotalDays >= 1 ? "age-warn" : "";
                    string agePrefix = waiting.TotalDays >= 3 ? "⚠ Overdue — waiting " : "⏱ Waiting ";

                    <div class="queue-item">
                        <div>
                            <div class="qi-id">OSR-@r.RequestId.ToString("000000")</div>
                            <div class="qi-part">@(r.SapDescription ?? r.PartNumber)</div>
                            <div class="qi-meta">Part: @r.PartNumber · Qty: @r.Quantity · by @r.CreatedByUsername</div>
                            <div class="qi-age @ageClass">@agePrefix@waitStr</div>
                        </div>
                        <a class="btn-review"
                           asp-controller="Outsource"
                           asp-action="Track"
                           asp-route-id="@r.RequestId">
                            Review →
                        </a>
                    </div>
                }
            </div>
        }
    }

</div>
