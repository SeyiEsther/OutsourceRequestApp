@{
    ViewData["Title"] = "Request Sent";
}

<style>
    body {
        background: #0f0f10;
        color: #e5e7eb;
        font-family: "Segoe UI", sans-serif;
    }

    .wrap {
        max-width: 700px;
        margin: 80px auto;
        padding: 20px;
        text-align: center;
    }

    .card {
        background: #151517;
        border: 1px solid #262626;
        border-radius: 14px;
        padding: 40px;
    }

    h2 {
        color: #ffffff;
        margin-bottom: 10px;
    }

    p {
        color: #9ca3af;
        margin-bottom: 30px;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    a {
        padding: 10px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
    }

    .primary {
        background: #e30613;
        color: white;
    }

    .secondary {
        border: 1px solid #444;
        color: #e5e7eb;
    }

    .primary:hover {
        background: #b90510;
    }

    .secondary:hover {
        background: #1f1f22;
    }
</style>

<div style="max-width:700px;margin:80px auto;text-align:center">

    <h2 style="color:#4ade80">Request Submitted</h2>

    <p>Your outsource request has been sent for approval.</p>

    <a href="/Outsource" style="
        display:inline-block;
        margin-top:20px;
        padding:10px 20px;
        background:#e30613;
        color:white;
        border-radius:6px;
        text-decoration:none;
    ">
        Back to Requests
    </a>

</div>